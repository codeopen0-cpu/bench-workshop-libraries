{"format":"bench-library","formatVersion":1,"id":"bluetooth-hc05","name":"Bluetooth (HC-05)","version":"1.0.0","author":"Bench Workshop","owner":"codeopen0-cpu","description":"The HC-05 Bluetooth serial module: whatever a phone sends comes out of its TXD as serial bytes, and whatever the board sends to its RXD goes to the phone. The phone is in the run panel: type a line and Send. Use SoftwareSerial or Serial1/Serial2.","category":"Wireless","needsApp":"0.3.0","code":"// HC-05: a serial port on one side, Bluetooth (here: the phone in the run panel) on the other.\nbench.device('hc05', (part) => {\n  const connected = part.control('connected');\n  const phone = part.control('phone');\n  const led = part.screen('led');\n  const baud = Number(part.params.baud ?? 9600);\n  let powered = false, got = '', sent = 0, garbled = 0, rxVolts = 0, blink = 0;\n  return {\n    packets(list) {\n      for (const p of list) {\n        if (p.pin !== 'RXD' || p.proto !== 'uart' || !powered) continue;\n        if (!connected.on) continue; // (nobody to send it to)\n        if (p.baud && Math.abs(p.baud - baud) > baud * 0.03) {\n          // the board talks at another speed: what the phone gets is garbage\n          garbled += p.data.length;\n          got += p.data.map(() => '?').join('');\n        } else got += String.fromCharCode(...p.data);\n        if (got.length > 400) got = got.slice(-400);\n      }\n    },\n    step(io) {\n      const v = io.supply('VCC', 'GND');\n      powered = v >= 3.4;\n      rxVolts = io.v('RXD') ?? 0;\n      if (!powered) {\n        for (const p of ['TXD', 'STATE']) io.release(p);\n        led.set(0, 0, 0);\n        io.draw(0);\n        return;\n      }\n      io.drive('TXD', 3.3, 1); // a serial line rests high\n      io.drive('STATE', connected.on ? 3.3 : 0, 1);\n      for (const line of phone.take()) {\n        if (!connected.on) continue;\n        const bytes = Array.from(line + '\\n', (ch) => ch.charCodeAt(0) & 255);\n        io.send('TXD', 'uart', bytes, baud);\n        sent += bytes.length;\n        part.log(`phone sent \"${line}\"`);\n      }\n      // its LED: fast blinking while waiting for a phone, two short blinks every 2 s when paired\n      blink = io.time % (connected.on ? 2 : 0.25);\n      led.set(0, 0, connected.on ? (blink < 0.1 || (blink > 0.25 && blink < 0.35) ? 1 : 0) : blink < 0.125 ? 1 : 0);\n      io.draw(connected.on ? 0.035 : 0.04);\n    },\n    status() {\n      if (!powered) return ['no power (VCC 3.6-6 V)'];\n      const lines = got.split(/\\r?\\n/).filter(Boolean);\n      return [\n        connected.on ? `phone connected, ${baud} baud` : 'waiting for a phone',\n        `the phone got: ${lines.slice(-3).join(' | ') || '(nothing yet)'}`,\n        ...(garbled ? [`${garbled} bytes arrived garbled: the board isn't at ${baud} baud`] : []),\n        ...(rxVolts > 3.8 ? [`RXD gets ${rxVolts.toFixed(1)} V: it takes 3.3 V (use a divider from a 5 V board)`] : []),\n      ];\n    },\n  };\n});\n","parts":[{"id":"hc05","name":"Bluetooth HC-05","description":"VCC (3.6-6 V), GND, TXD to the board's RX, RXD to the board's TX (RXD takes 3.3 V: from a 5 V board, use a divider), STATE is high while a phone is connected. 9600 baud unless you change it in its settings. The run panel has the phone: connect it, type, Send.","swatch":"#1d4fb8","mass":4,"params":[{"key":"baud","label":"Baud rate","kind":"select","options":[{"value":"9600","label":"9600 (as it comes)"},{"value":"38400","label":"38400"},{"value":"57600","label":"57600"},{"value":"115200","label":"115200"}]}],"defaults":{"baud":"9600"},"shape":[{"box":[1.6,0.16,4.4],"at":[0,0.08,0],"color":"#1d4fb8"},{"box":[1.3,0.2,2.6],"at":[0,0.26,0.6],"color":"#2a6e2a"},{"box":[1.2,0.05,1],"at":[0,0.39,1.4],"color":"#c9a24a","collide":false},{"screen":{"id":"led","size":[0.25,0.25],"px":[1,1],"mode":"pixels","on":"#ff3020","off":"#3a1210","bg":"#1d4fb8"},"at":[0.5,0.17,-1.4]}],"pinRows":[{"ids":["STATE","RXD","TXD","GND","VCC","EN"],"at":[-0.635,0,-2],"kinds":{"STATE":"out","RXD":"in","TXD":"out","GND":"gnd","VCC":"vin","EN":"in"},"extra":{"VCC":{"label":"VCC (3.6-6 V)","vmin":3.4,"vmax":6},"EN":{"label":"EN (unused)","pulled":"down"},"STATE":{"pulled":"down"}}}],"controls":[{"id":"connected","kind":"switch","label":"Phone connected","value":true},{"id":"phone","kind":"text","label":"Phone sends..."}],"device":"hc05"}],"examples":[{"name":"Phone switches an LED","description":"Type on and off on the phone (the HC-05's card in the run panel): the board switches its LED and answers. The HC-05 is on Serial1 (GP0/GP1).","project":{"format":"bench-workshop","version":1,"name":"Phone switches an LED","parts":[{"uid":"board","type":"maker-board","name":"Board","params":{"usb":true},"parent":null,"pos":[-6,0,0],"rot":[0,0,0,1]},{"uid":"bt","type":"bluetooth-hc05/hc05","name":"HC-05","params":{"baud":"9600"},"parent":null,"pos":[5,0,-2],"rot":[0,0,0,1]},{"uid":"led","type":"led","name":"LED","params":{"color":"green"},"parent":null,"pos":[0,0,6],"rot":[0,0,0,1]}],"wires":[{"id":"w1","a":{"uid":"board","pin":"5V"},"b":{"uid":"bt","pin":"VCC"},"color":"#e04848"},{"id":"w2","a":{"uid":"board","pin":"GND"},"b":{"uid":"bt","pin":"GND"},"color":"#2b2d33"},{"id":"w3","a":{"uid":"board","pin":"GP0"},"b":{"uid":"bt","pin":"RXD"},"color":"#4f9cff"},{"id":"w4","a":{"uid":"board","pin":"GP1"},"b":{"uid":"bt","pin":"TXD"},"color":"#3fbf7f"},{"id":"w5","a":{"uid":"board","pin":"GP15"},"b":{"uid":"led","pin":"A"},"color":"#e8c547"},{"id":"w6","a":{"uid":"board","pin":"GND2"},"b":{"uid":"led","pin":"K"},"color":"#2b2d33"}],"programs":{"board":{"lang":"arduino","source":"// Type \"on\" or \"off\" on the phone (the HC-05's card in the run panel).\n// The HC-05 is on Serial1: the board's TX (GP0) to its RXD, the board's RX (GP1) from its TXD.\n#define LED 15\n\nvoid setup() {\n  Serial.begin(115200);\n  Serial1.begin(9600);         // the HC-05's speed\n  pinMode(LED, OUTPUT);\n  Serial1.println(\"Hello phone! Send on or off.\");\n}\n\nvoid loop() {\n  if (Serial1.available()) {\n    String cmd = Serial1.readStringUntil('\\n');\n    cmd.trim();\n    Serial.print(\"phone says: \");\n    Serial.println(cmd);\n    if (cmd == \"on\") {\n      digitalWrite(LED, HIGH);\n      Serial1.println(\"LED is on\");\n    } else if (cmd == \"off\") {\n      digitalWrite(LED, LOW);\n      Serial1.println(\"LED is off\");\n    } else {\n      Serial1.println(\"Send on or off\");\n    }\n  }\n}\n"}},"boards":[]}}]}