{"format":"bench-library","formatVersion":1,"id":"gps-neo6m","name":"GPS module (NEO-6M)","version":"1.0.0","author":"Bench Workshop","owner":"codeopen0-cpu","description":"A GPS receiver: after a few seconds it gets a fix and sends its position as NMEA sentences on its TX pin (9600 baud), once a second. Its position is where it is on the bench (the bench sits at a latitude and longitude you choose; north is -z): carry it about and the position follows. Includes TinyGPSPlus.h (and TinyGPS++.h).","category":"Sensors","needsApp":"0.4.0","code":"// NEO-6M: once a second, $GPRMC and $GPGGA (and $GPVTG) on TX at 9600 baud, from where the part is\r\n// on the bench (x east, -z north, cm; the bench's origin at the latitude and longitude set).\r\n// Without a fix (the first seconds) the sentences say so.\r\nconst nmea = (body) => {\r\n  let x = 0;\r\n  for (const ch of body) x ^= ch.charCodeAt(0);\r\n  return `$${body}*${x.toString(16).toUpperCase().padStart(2, '0')}\\r\\n`;\r\n};\r\nconst dm = (deg, isLat) => {\r\n  const a = Math.abs(deg), d = Math.floor(a), m = (a - d) * 60;\r\n  return `${String(d).padStart(isLat ? 2 : 3, '0')}${m.toFixed(5).padStart(8, '0')},${isLat ? (deg >= 0 ? 'N' : 'S') : deg >= 0 ? 'E' : 'W'}`;\r\n};\r\nconst two = (n) => String(n).padStart(2, '0');\r\n\r\nbench.device('neo6m', (part) => {\r\n  const lat0 = Number(part.params.lat ?? 51.5007), lon0 = Number(part.params.lon ?? -0.1246), alt0 = Number(part.params.alt ?? 12);\r\n  const fixAfter = Number(part.params.fix ?? 4);\r\n  const t0 = Date.now(); // (its clock: UTC from this PC, moving with the simulation)\r\n  let powered = false, since = -1, next = 0, fix = false, lat = lat0, lon = lon0, alt = alt0, knots = 0, course = 0, sent = 0;\r\n  return {\r\n    step(io) {\r\n      const v = io.supply('VCC', 'GND');\r\n      const on = v >= 2.7;\r\n      if (on && !powered) { since = io.time; next = io.time + 1; }\r\n      powered = on;\r\n      if (!powered) { io.release('TX'); io.draw(0); fix = false; return; }\r\n      io.drive('TX', v, 1); // (a serial line rests high)\r\n      const m = part.motion();\r\n      fix = io.time - since >= fixAfter;\r\n      const north = -m.pos[2] / 100, east = m.pos[0] / 100; // m\r\n      lat = lat0 + north / 111320;\r\n      lon = lon0 + east / (111320 * Math.cos((lat0 * Math.PI) / 180));\r\n      alt = alt0 + m.pos[1] / 100;\r\n      const vh = Math.hypot(m.vel[0], m.vel[2]) / 100; // m/s\r\n      knots = vh * 1.943844;\r\n      if (vh > 0.05) course = ((Math.atan2(m.vel[0], -m.vel[2]) * 180) / Math.PI + 360) % 360;\r\n      io.draw(fix ? 0.045 : 0.05);\r\n      if (io.time < next) return;\r\n      next += 1;\r\n      const d = new Date(t0 + io.time * 1000);\r\n      const hms = `${two(d.getUTCHours())}${two(d.getUTCMinutes())}${two(d.getUTCSeconds())}.00`;\r\n      const date = `${two(d.getUTCDate())}${two(d.getUTCMonth() + 1)}${two(d.getUTCFullYear() % 100)}`;\r\n      const L = fix ? dm(lat, true) : ',', G = fix ? dm(lon, false) : ',';\r\n      let text = '';\r\n      text += nmea(`GPRMC,${hms},${fix ? 'A' : 'V'},${L},${G},${fix ? knots.toFixed(3) : ''},${fix ? course.toFixed(2) : ''},${date},,,${fix ? 'A' : 'N'}`);\r\n      text += nmea(`GPVTG,${fix ? course.toFixed(2) : ''},T,,M,${fix ? knots.toFixed(3) : ''},N,${fix ? (knots * 1.852).toFixed(3) : ''},K,${fix ? 'A' : 'N'}`);\r\n      text += nmea(`GPGGA,${hms},${L},${G},${fix ? 1 : 0},${fix ? '08' : '00'},${fix ? '0.92' : '99.99'},${fix ? alt.toFixed(1) : ''},M,${fix ? '47.0' : ''},M,,`);\r\n      io.send('TX', 'uart', Array.from(text, (ch) => ch.charCodeAt(0)), 9600);\r\n      sent++;\r\n    },\r\n    status() {\r\n      if (!powered) return ['no power'];\r\n      if (!fix) return [`searching for satellites... (about ${Math.max(1, Math.ceil(fixAfter - sent))} s)`];\r\n      return [`fix: ${lat.toFixed(6)}, ${lon.toFixed(6)}, ${alt.toFixed(1)} m, ${(knots * 1.852).toFixed(1)} km/h`, `${sent} reports sent`];\r\n    },\r\n  };\r\n});\r\n","sketch":{"TinyGPSPlus.h":{"classes":["TinyGPSPlus"],"code":"// TinyGPSPlus.h (Mikal Hart's TinyGPS++): TinyGPSPlus gps;  while (Serial1.available()) gps.encode(Serial1.read());\n//   gps.location.isValid(), isUpdated(), lat(), lng(), age();  gps.date.year() month() day();\n//   gps.time.hour() minute() second() centisecond();  gps.speed.kmph() mps() knots() mph();  gps.course.deg();\n//   gps.altitude.meters();  gps.satellites.value();  gps.hdop.hdop();  gps.charsProcessed();\n//   TinyGPSPlus::distanceBetween(lat1, lng1, lat2, lng2) (m), courseTo(...) (deg), cardinal(deg)\nclass _GpsVal {\n  constructor() { this.valid = false; this.updated = false; this.v = 0; this.at = 0; }\n  set(v) { this.v = v; this.valid = true; this.updated = true; this.at = millis(); }\n  isValid() { return this.valid; }\n  isUpdated() { const u = this.updated; this.updated = false; return u; }\n  age() { return this.valid ? millis() - this.at : 0xffffffff; }\n  value() { this.updated = false; return this.v; }\n}\nclass TinyGPSPlus {\n  constructor() {\n    this.buf = '';\n    this.chars = 0; this.passed = 0; this.failed = 0; this.fixes = 0;\n    const loc = new _GpsVal();\n    loc.v = { lat: 0, lng: 0 };\n    loc.lat = () => { loc.updated = false; return loc.v.lat; };\n    loc.lng = () => { loc.updated = false; return loc.v.lng; };\n    this.location = loc;\n    const date = new _GpsVal();\n    date.year = () => 2000 + (date.v % 100); date.month = () => Math.floor(date.v / 100) % 100; date.day = () => Math.floor(date.v / 10000);\n    this.date = date;\n    const time = new _GpsVal();\n    time.hour = () => Math.floor(time.v / 1000000); time.minute = () => Math.floor(time.v / 10000) % 100; time.second = () => Math.floor(time.v / 100) % 100; time.centisecond = () => time.v % 100;\n    this.time = time;\n    const speed = new _GpsVal();\n    speed.knots = () => speed.v; speed.kmph = () => speed.v * 1.852; speed.mps = () => speed.v * 0.514444; speed.mph = () => speed.v * 1.15078;\n    this.speed = speed;\n    const course = new _GpsVal();\n    course.deg = () => course.v;\n    this.course = course;\n    const alt = new _GpsVal();\n    alt.meters = () => alt.v; alt.feet = () => alt.v * 3.28084; alt.kilometers = () => alt.v / 1000;\n    this.altitude = alt;\n    this.satellites = new _GpsVal();\n    const hdop = new _GpsVal();\n    hdop.hdop = () => hdop.v;\n    this.hdop = hdop;\n  }\n  charsProcessed() { return this.chars; }\n  sentencesWithFix() { return this.fixes; }\n  failedChecksum() { return this.failed; }\n  passedChecksum() { return this.passed; }\n  /** feed one character; true when it finished a sentence that made sense */\n  encode(c) {\n    this.chars++;\n    const ch = typeof c === 'number' ? String.fromCharCode(c) : String(c);\n    if (ch === '$') { this.buf = '$'; return false; }\n    if (ch === '\\n' || ch === '\\r') {\n      const s = this.buf;\n      this.buf = '';\n      return s.length > 6 ? this._sentence(s) : false;\n    }\n    if (this.buf.length < 120) this.buf += ch;\n    return false;\n  }\n  _sentence(s) {\n    const star = s.indexOf('*');\n    if (star < 0) return false;\n    const body = s.slice(1, star);\n    let x = 0;\n    for (const ch of body) x ^= ch.charCodeAt(0);\n    if (x !== parseInt(s.slice(star + 1, star + 3), 16)) { this.failed++; return false; }\n    this.passed++;\n    const f = body.split(',');\n    const coord = (v, h, isLat) => {\n      if (!v) return null;\n      const d = Math.floor(Number(v) / 100), m = Number(v) - d * 100;\n      const deg = d + m / 60;\n      return h === 'S' || h === 'W' ? -deg : deg;\n    };\n    const type = f[0].slice(2);\n    if (type === 'RMC') {\n      if (f[1]) this.time.set(Math.round(Number(f[1]) * 100));\n      if (f[9]) this.date.set(Number(f[9]));\n      if (f[2] === 'A') {\n        this.location.set({ lat: coord(f[3], f[4], true), lng: coord(f[5], f[6], false) });\n        if (f[7]) this.speed.set(Number(f[7]));\n        if (f[8]) this.course.set(Number(f[8]));\n        this.fixes++;\n      }\n      return true;\n    }\n    if (type === 'GGA') {\n      if (f[1]) this.time.set(Math.round(Number(f[1]) * 100));\n      this.satellites.set(Number(f[7] || 0));\n      this.hdop.set(Number(f[8] || 99.99));\n      if (Number(f[6]) > 0) {\n        this.location.set({ lat: coord(f[2], f[3], true), lng: coord(f[4], f[5], false) });\n        if (f[9]) this.altitude.set(Number(f[9]));\n        this.fixes++;\n      }\n      return true;\n    }\n    return type === 'VTG' || type === 'GSA' || type === 'GSV';\n  }\n}\nTinyGPSPlus.distanceBetween = (lat1, lng1, lat2, lng2) => {\n  const r = Math.PI / 180, dLat = (lat2 - lat1) * r, dLng = (lng2 - lng1) * r;\n  const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * r) * Math.cos(lat2 * r) * Math.sin(dLng / 2) ** 2;\n  return 6372795 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\n};\nTinyGPSPlus.courseTo = (lat1, lng1, lat2, lng2) => {\n  const r = Math.PI / 180, dLng = (lng2 - lng1) * r;\n  const y = Math.sin(dLng) * Math.cos(lat2 * r), x = Math.cos(lat1 * r) * Math.sin(lat2 * r) - Math.sin(lat1 * r) * Math.cos(lat2 * r) * Math.cos(dLng);\n  return ((Math.atan2(y, x) / r) + 360) % 360;\n};\nTinyGPSPlus.cardinal = (deg) => ['N', 'NNE', 'NE', 'ENE', 'E', 'ESE', 'SE', 'SSE', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'][Math.round((((deg % 360) + 360) % 360) / 22.5) % 16];\n"},"TinyGPS++.h":{"classes":["TinyGPSPlus"],"code":"// TinyGPSPlus.h (Mikal Hart's TinyGPS++): TinyGPSPlus gps;  while (Serial1.available()) gps.encode(Serial1.read());\n//   gps.location.isValid(), isUpdated(), lat(), lng(), age();  gps.date.year() month() day();\n//   gps.time.hour() minute() second() centisecond();  gps.speed.kmph() mps() knots() mph();  gps.course.deg();\n//   gps.altitude.meters();  gps.satellites.value();  gps.hdop.hdop();  gps.charsProcessed();\n//   TinyGPSPlus::distanceBetween(lat1, lng1, lat2, lng2) (m), courseTo(...) (deg), cardinal(deg)\nclass _GpsVal {\n  constructor() { this.valid = false; this.updated = false; this.v = 0; this.at = 0; }\n  set(v) { this.v = v; this.valid = true; this.updated = true; this.at = millis(); }\n  isValid() { return this.valid; }\n  isUpdated() { const u = this.updated; this.updated = false; return u; }\n  age() { return this.valid ? millis() - this.at : 0xffffffff; }\n  value() { this.updated = false; return this.v; }\n}\nclass TinyGPSPlus {\n  constructor() {\n    this.buf = '';\n    this.chars = 0; this.passed = 0; this.failed = 0; this.fixes = 0;\n    const loc = new _GpsVal();\n    loc.v = { lat: 0, lng: 0 };\n    loc.lat = () => { loc.updated = false; return loc.v.lat; };\n    loc.lng = () => { loc.updated = false; return loc.v.lng; };\n    this.location = loc;\n    const date = new _GpsVal();\n    date.year = () => 2000 + (date.v % 100); date.month = () => Math.floor(date.v / 100) % 100; date.day = () => Math.floor(date.v / 10000);\n    this.date = date;\n    const time = new _GpsVal();\n    time.hour = () => Math.floor(time.v / 1000000); time.minute = () => Math.floor(time.v / 10000) % 100; time.second = () => Math.floor(time.v / 100) % 100; time.centisecond = () => time.v % 100;\n    this.time = time;\n    const speed = new _GpsVal();\n    speed.knots = () => speed.v; speed.kmph = () => speed.v * 1.852; speed.mps = () => speed.v * 0.514444; speed.mph = () => speed.v * 1.15078;\n    this.speed = speed;\n    const course = new _GpsVal();\n    course.deg = () => course.v;\n    this.course = course;\n    const alt = new _GpsVal();\n    alt.meters = () => alt.v; alt.feet = () => alt.v * 3.28084; alt.kilometers = () => alt.v / 1000;\n    this.altitude = alt;\n    this.satellites = new _GpsVal();\n    const hdop = new _GpsVal();\n    hdop.hdop = () => hdop.v;\n    this.hdop = hdop;\n  }\n  charsProcessed() { return this.chars; }\n  sentencesWithFix() { return this.fixes; }\n  failedChecksum() { return this.failed; }\n  passedChecksum() { return this.passed; }\n  /** feed one character; true when it finished a sentence that made sense */\n  encode(c) {\n    this.chars++;\n    const ch = typeof c === 'number' ? String.fromCharCode(c) : String(c);\n    if (ch === '$') { this.buf = '$'; return false; }\n    if (ch === '\\n' || ch === '\\r') {\n      const s = this.buf;\n      this.buf = '';\n      return s.length > 6 ? this._sentence(s) : false;\n    }\n    if (this.buf.length < 120) this.buf += ch;\n    return false;\n  }\n  _sentence(s) {\n    const star = s.indexOf('*');\n    if (star < 0) return false;\n    const body = s.slice(1, star);\n    let x = 0;\n    for (const ch of body) x ^= ch.charCodeAt(0);\n    if (x !== parseInt(s.slice(star + 1, star + 3), 16)) { this.failed++; return false; }\n    this.passed++;\n    const f = body.split(',');\n    const coord = (v, h, isLat) => {\n      if (!v) return null;\n      const d = Math.floor(Number(v) / 100), m = Number(v) - d * 100;\n      const deg = d + m / 60;\n      return h === 'S' || h === 'W' ? -deg : deg;\n    };\n    const type = f[0].slice(2);\n    if (type === 'RMC') {\n      if (f[1]) this.time.set(Math.round(Number(f[1]) * 100));\n      if (f[9]) this.date.set(Number(f[9]));\n      if (f[2] === 'A') {\n        this.location.set({ lat: coord(f[3], f[4], true), lng: coord(f[5], f[6], false) });\n        if (f[7]) this.speed.set(Number(f[7]));\n        if (f[8]) this.course.set(Number(f[8]));\n        this.fixes++;\n      }\n      return true;\n    }\n    if (type === 'GGA') {\n      if (f[1]) this.time.set(Math.round(Number(f[1]) * 100));\n      this.satellites.set(Number(f[7] || 0));\n      this.hdop.set(Number(f[8] || 99.99));\n      if (Number(f[6]) > 0) {\n        this.location.set({ lat: coord(f[2], f[3], true), lng: coord(f[4], f[5], false) });\n        if (f[9]) this.altitude.set(Number(f[9]));\n        this.fixes++;\n      }\n      return true;\n    }\n    return type === 'VTG' || type === 'GSA' || type === 'GSV';\n  }\n}\nTinyGPSPlus.distanceBetween = (lat1, lng1, lat2, lng2) => {\n  const r = Math.PI / 180, dLat = (lat2 - lat1) * r, dLng = (lng2 - lng1) * r;\n  const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * r) * Math.cos(lat2 * r) * Math.sin(dLng / 2) ** 2;\n  return 6372795 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\n};\nTinyGPSPlus.courseTo = (lat1, lng1, lat2, lng2) => {\n  const r = Math.PI / 180, dLng = (lng2 - lng1) * r;\n  const y = Math.sin(dLng) * Math.cos(lat2 * r), x = Math.cos(lat1 * r) * Math.sin(lat2 * r) - Math.sin(lat1 * r) * Math.cos(lat2 * r) * Math.cos(dLng);\n  return ((Math.atan2(y, x) / r) + 360) % 360;\n};\nTinyGPSPlus.cardinal = (deg) => ['N', 'NNE', 'NE', 'ENE', 'E', 'ESE', 'SE', 'SSE', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'][Math.round((((deg % 360) + 360) % 360) / 22.5) % 16];\n"}},"parts":[{"id":"neo6m","name":"GPS (NEO-6M module)","description":"VCC (3.3-5 V), GND, TX to the board's RX (Serial1, or SoftwareSerial), RX from its TX (not needed to read it). 9600 baud. Its LED blinks once a second when it has a fix.","swatch":"#2a6b3a","mass":12,"params":[{"key":"lat","label":"Bench latitude","kind":"number","min":-89.9,"max":89.9,"step":0.0001},{"key":"lon","label":"Bench longitude","kind":"number","min":-180,"max":180,"step":0.0001},{"key":"alt","label":"Bench altitude (m)","kind":"number","min":-400,"max":9000,"step":1},{"key":"fix","label":"Seconds to a fix","kind":"number","min":0,"max":60,"step":1}],"defaults":{"lat":51.5007,"lon":-0.1246,"alt":12,"fix":4},"shape":[{"box":[3.6,0.16,2.6],"at":[0,0.08,0],"color":"#2a6b3a"},{"box":[1.6,0.25,1.2],"at":[-0.6,0.285,0],"color":"#c9cdd4"},{"box":[2.5,0.4,2.5],"at":[0,0.75,4],"color":"#c8a050"},{"box":[1.8,0.05,1.8],"at":[0,0.975,4],"color":"#d8d0c0","collide":false},{"box":[0.25,0.1,0.25],"at":[1.3,0.21,-0.8],"color":"#30e030","collide":false}],"pinRows":[{"ids":["VCC","RX","TX","GND"],"at":[-0.381,0,-1.1],"kinds":{"VCC":"vin","RX":"in","TX":"out","GND":"gnd"},"extra":{"VCC":{"label":"VCC (3.3-5 V)","vmin":2.7,"vmax":5.5},"TX":{"label":"TX (to the board's RX)"},"RX":{"label":"RX (from the board's TX)"}}}],"device":"neo6m"}],"examples":[{"name":"Where am I","description":"A board reads the GPS (Serial1) and prints its position, speed and how far it has moved. Press Run, wait for the fix, then pick the GPS up and carry it: the position changes (1 m on the bench = 1 m on Earth).","project":{"format":"bench-workshop","version":1,"name":"Where am I","parts":[{"uid":"board","type":"maker-board","name":"Board","params":{"usb":true},"parent":null,"pos":[-10,0,0],"rot":[0,0,0,1]},{"uid":"gps","type":"gps-neo6m/neo6m","name":"GPS","params":{},"parent":null,"pos":[5,0,0],"rot":[0,0,0,1]}],"wires":[{"id":"w1","a":{"uid":"board","pin":"3V3"},"b":{"uid":"gps","pin":"VCC"},"color":"#e04848","length":80},{"id":"w2","a":{"uid":"board","pin":"GND"},"b":{"uid":"gps","pin":"GND"},"color":"#2b2d33","length":80},{"id":"w3","a":{"uid":"gps","pin":"TX"},"b":{"uid":"board","pin":"GP1"},"color":"#e8c547","length":80},{"id":"w4","a":{"uid":"board","pin":"GP0"},"b":{"uid":"gps","pin":"RX"},"color":"#4a90e2","length":80}],"programs":{"board":{"lang":"arduino","source":"// Where am I: reads the GPS on Serial1 and prints where it is. Wait for the fix, then pick the GPS\n// up (drag it) and carry it about: 1 m on the bench is 1 m on Earth.\n#include <TinyGPSPlus.h>\n\nTinyGPSPlus gps;\ndouble startLat = 0, startLng = 0;\nbool haveStart = false;\nunsigned long lastPrint = 0;\n\nvoid setup() {\n  Serial.begin(115200);\n  Serial1.begin(9600);   // the GPS's TX goes to RX1 (GP1)\n  Serial.println(\"waiting for a fix...\");\n}\n\nvoid loop() {\n  while (Serial1.available()) gps.encode(Serial1.read());\n  if (millis() - lastPrint < 1000) return;\n  lastPrint = millis();\n  if (!gps.location.isValid()) {\n    Serial.print(\"no fix yet, satellites: \");\n    Serial.println(gps.satellites.value());\n    return;\n  }\n  double lat = gps.location.lat(), lng = gps.location.lng();\n  if (!haveStart) { startLat = lat; startLng = lng; haveStart = true; }\n  double moved = TinyGPSPlus::distanceBetween(startLat, startLng, lat, lng);\n  Serial.print(lat, 6);\n  Serial.print(\", \");\n  Serial.print(lng, 6);\n  Serial.print(\"  \");\n  Serial.print(gps.speed.kmph(), 1);\n  Serial.print(\" km/h  moved \");\n  Serial.print(moved * 100, 0);\n  Serial.println(\" cm\");\n}\n"}},"boards":[]}}]}