":[-40.480104157665046,0.3,31.39054595364409],"rot":[0,0.9738769792773336,0,0.22707626303437323],"pinned":true},{"uid":"w21","type":"plate","name":"Tape","params":{"w":4.831489286485115,"h":0.06,"d":2.5,"material":"plastic","color":"#151515"},"parent":null,"pos":[-36.25038128561066,0.3,33.142554532328695],"rot":[0,0.986643332084879,0,0.16289547339458882],"pinned":true},{"uid":"w22","type":"plate","name":"Tape","params":{"w":4.831489286485115,"h":0.06,"d":2.5,"material":"plastic","color":"#151515"},"parent":null,"pos":[-31.8281612705645,0.3,34.32748481411306],"rot":[0,0.9951847266721968,0,0.09801714032956077],"pinned":true},{"uid":"w23","type":"plate","name":"Tape","params":{"w":4.831489286485115,"h":0.06,"d":2.5,"material":"plastic","color":"#151515"},"parent":null,"pos":[-27.28910952305501,0.3,34.92506231335112],"rot":[0,0.9994645874763657,0,0.032719082821776165],"pinned":true}],"wires":[{"id":"w1","a":{"uid":"battery","pin":"+"},"b":{"uid":"driver","pin":"VM"},"color":"#e04848"},{"id":"w2","a":{"uid":"battery","pin":"-"},"b":{"uid":"driver","pin":"GND"},"color":"#2b2d33"},{"id":"w3","a":{"uid":"battery","pin":"+"},"b":{"uid":"brain","pin":"VIN"},"color":"#e04848"},{"id":"w4","a":{"uid":"battery","pin":"-"},"b":{"uid":"brain","pin":"GND2"},"color":"#2b2d33"},{"id":"w5","a":{"uid":"brain","pin":"GP2"},"b":{"uid":"driver","pin":"AIN1"},"color":"#e8c547"},{"id":"w6","a":{"uid":"brain","pin":"GP3"},"b":{"uid":"driver","pin":"AIN2"},"color":"#e8c547"},{"id":"w7","a":{"uid":"brain","pin":"GP5"},"b":{"uid":"driver","pin":"BIN1"},"color":"#4a90e2"},{"id":"w8","a":{"uid":"brain","pin":"GP6"},"b":{"uid":"driver","pin":"BIN2"},"color":"#4a90e2"},{"id":"w9","a":{"uid":"driver","pin":"AOUT1"},"b":{"uid":"motorR","pin":"M+"},"color":"#e04848"},{"id":"w10","a":{"uid":"driver","pin":"AOUT2"},"b":{"uid":"motorR","pin":"M-"},"color":"#2b2d33"},{"id":"w11","a":{"uid":"driver","pin":"BOUT1"},"b":{"uid":"motorL","pin":"M+"},"color":"#e04848"},{"id":"w12","a":{"uid":"driver","pin":"BOUT2"},"b":{"uid":"motorL","pin":"M-"},"color":"#2b2d33"},{"id":"w13","a":{"uid":"brain","pin":"3V3"},"b":{"uid":"lineL","pin":"VCC"},"color":"#e04848"},{"id":"w14","a":{"uid":"brain","pin":"GND"},"b":{"uid":"lineL","pin":"GND"},"color":"#2b2d33"},{"id":"w15","a":{"uid":"brain","pin":"GP10"},"b":{"uid":"lineL","pin":"DO"},"color":"#e8c547"},{"id":"w16","a":{"uid":"brain","pin":"3V3"},"b":{"uid":"lineR","pin":"VCC"},"color":"#e04848"},{"id":"w17","a":{"uid":"brain","pin":"GND"},"b":{"uid":"lineR","pin":"GND"},"color":"#2b2d33"},{"id":"w18","a":{"uid":"brain","pin":"GP11"},"b":{"uid":"lineR","pin":"DO"},"color":"#4a90e2"}],"programs":{"brain":{"lang":"arduino","source":"#define AIN1 2    // right motor (through the DRV8833)\n#define AIN2 3\n#define BIN1 5    // left motor\n#define BIN2 6\n\nvoid motor(int in1, int in2, int speed) {\n  if (speed >= 0) { analogWrite(in1, speed); analogWrite(in2, 0); }\n  else            { analogWrite(in1, 0);     analogWrite(in2, -speed); }\n}\n\nvoid drive(int left, int right) {   // -255 .. 255\n  motor(BIN1, BIN2, left);\n  motor(AIN2, AIN1, right);         // the right motor faces the other way\n}\n\n// Line-following robot: two line sensors under its nose, close together, look at the paper. Over\n// the line both see black: straight on. When one slides off the edge, it steers back; if it loses\n// the line altogether it turns back the way it last saw it.\n#define LEFT 10    // left sensor's DO: HIGH over the black line\n#define RIGHT 11   // right sensor's DO\n\nint lastSide = 0;  // where the line was last: -1 left, 1 right\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(LEFT, INPUT);\n  pinMode(RIGHT, INPUT);\n  Serial.println(\"following the line\");\n}\n\nvoid loop() {\n  bool left = digitalRead(LEFT) == HIGH;\n  bool right = digitalRead(RIGHT) == HIGH;\n  if (left && right) drive(90, 90);                         // on the line\n  else if (left) { drive(50, 120); lastSide = -1; }         // the line is going left\n  else if (right) { drive(120, 50); lastSide = 1; }         // going right\n  else if (lastSide < 0) drive(-30, 90);                    // lost it: turn back to it\n  else if (lastSide > 0) drive(90, -30);\n  else drive(100, 100);\n  delay(5);\n}\n"}},"boards":[]}}]}