{"format":"bench-library","formatVersion":1,"id":"rfid-rc522","name":"RFID reader (RC522) and tags","version":"1.0.0","author":"Bench Workshop","owner":"codeopen0-cpu","description":"The RC522 RFID reader (SPI) with MIFARE Classic tags: a white card and a blue key fob. Hold a tag up to the reader (drag it within a few cm of the coil) and the program reads its ID, and can read and write its 1 KB memory. Includes MFRC522.h.","category":"Sensors","needsApp":"0.4.0","code":"// RC522 reader and MIFARE Classic 1K tags.\r\n// Tags say where they are (a shared list: all parts of this library run in one thread); the reader\r\n// talks to the nearest one within reach of its coil. The reader's registers are the real chip's (the\r\n// ones MFRC522.h uses); its SPI: a byte (reg << 1) | 0x80 to read, (reg << 1) to write, then data.\r\nconst tags = new Map(); // uid number -> { pos, mem, name, halted, state, auth }\r\nconst crcA = (bytes) => {\r\n  let crc = 0x6363;\r\n  for (let b of bytes) {\r\n    b = (b ^ (crc & 0xff)) & 0xff;\r\n    b = (b ^ (b << 4)) & 0xff;\r\n    crc = ((crc >> 8) ^ (b << 8) ^ (b << 3) ^ (b >> 4)) & 0xffff;\r\n  }\r\n  return [crc & 0xff, crc >> 8];\r\n};\r\nconst newMemory = (uid) => {\r\n  const mem = new Array(1024).fill(0);\r\n  const u = [(uid >>> 24) & 255, (uid >>> 16) & 255, (uid >>> 8) & 255, uid & 255];\r\n  mem.splice(0, 8, ...u, u[0] ^ u[1] ^ u[2] ^ u[3], 0x08, 0x04, 0x00);\r\n  for (let s = 0; s < 16; s++) mem.splice(s * 64 + 48, 16, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x07, 0x80, 0x69, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff);\r\n  return { u, mem };\r\n};\r\n\r\nbench.device('tag', (part) => {\r\n  const id = (Number(part.params.uid ?? 0) >>> 0) || 1;\r\n  const t = { ...newMemory(id), pos: null, name: part.name, halted: false, state: 'idle', auth: -1, virtual: false };\r\n  tags.set(id, t);\r\n  return {\r\n    step() { t.pos = part.motion().pos; },\r\n    status() {\r\n      return [`ID ${t.u.map((b) => b.toString(16).padStart(2, '0')).join(' ')}${t.state === 'active' ? ': being read' : ''}`];\r\n    },\r\n  };\r\n});\r\n\r\nbench.device('rc522', (part) => {\r\n  const hold = part.control('hold');\r\n  const regs = new Array(64).fill(0);\r\n  let fifo = [], powered = false, near = null, held = null, reads = 0, lastTagName = '', pendingWrite = null;\r\n  // two cards from the run panel, if no real ones are on the bench to hold up\r\n  const panel = { 'Card 1': { ...newMemory(0x11223344), pos: null, name: 'Card 1 (run panel)', halted: false, state: 'idle', auth: -1 },\r\n                  'Card 2': { ...newMemory(0x55667788), pos: null, name: 'Card 2 (run panel)', halted: false, state: 'idle', auth: -1 } };\r\n  const reset = () => {\r\n    regs.fill(0);\r\n    regs[0x37] = 0x92; // VersionReg: v2.0\r\n    regs[0x0a] = 0; regs[0x14] = 0x80; regs[0x01] = 0x20;\r\n    fifo = [];\r\n  };\r\n  reset();\r\n  const irq = (bits) => { regs[0x04] |= bits; };\r\n  const answer = (bytes, lastBits = 0) => {\r\n    fifo = bytes.slice(0, 64);\r\n    regs[0x0a] = fifo.length;\r\n    regs[0x0c] = (regs[0x0c] & ~7) | (lastBits & 7);\r\n    regs[0x06] = 0;\r\n    irq(0x30); // RxIRq, IdleIRq\r\n  };\r\n  const timeout = () => { regs[0x06] = 0; irq(0x01); }; // TimerIRq only: nobody answered (the command never finishes)\r\n  const block = (tag, n) => tag.mem.slice(n * 16, n * 16 + 16);\r\n  // a frame to the tag in the field (ISO 14443-A and MIFARE commands)\r\n  const transceive = () => {\r\n    const data = fifo.slice();\r\n    fifo = [];\r\n    regs[0x0a] = 0;\r\n    const antenna = (regs[0x14] & 3) === 3;\r\n    const tag = antenna ? near : null;\r\n    if (!tag) return timeout();\r\n    const bits = regs[0x0d] & 7;\r\n    if (bits === 7 && (data[0] === 0x26 || data[0] === 0x52)) { // REQA / WUPA\r\n      if (tag.halted && data[0] === 0x26) return timeout();\r\n      tag.halted = false; tag.state = 'ready'; tag.auth = -1;\r\n      return answer([0x04, 0x00]);\r\n    }\r\n    if (data[0] === 0x93 && data[1] === 0x20 && tag.state !== 'idle') return answer([...tag.u, tag.u[0] ^ tag.u[1] ^ tag.u[2] ^ tag.u[3]]);\r\n    if (data[0] === 0x93 && data[1] === 0x70 && tag.state !== 'idle') {\r\n      if (data.slice(2, 6).join() !== tag.u.join()) return timeout();\r\n      tag.state = 'active';\r\n      return answer([0x08, ...crcA([0x08])]);\r\n    }\r\n    if (data[0] === 0x50 && data[1] === 0x00) { tag.halted = true; tag.state = 'idle'; tag.auth = -1; return timeout(); } // HLTA: no answer\r\n    if (tag.state !== 'active') return timeout();\r\n    if (pendingWrite !== null) { // the 16 bytes after a WRITE command\r\n      const n = pendingWrite;\r\n      pendingWrite = null;\r\n      if (data.length >= 16 && n > 0) for (let i = 0; i < 16; i++) tag.mem[n * 16 + i] = data[i] & 255;\r\n      return answer([0x0a], 4);\r\n    }\r\n    const sector = (n) => Math.floor(n / 4);\r\n    if (data[0] === 0x30) { // READ\r\n      if (tag.auth !== sector(data[1])) return answer([0x04], 4); // NAK: not authenticated\r\n      const b = block(tag, data[1] & 63);\r\n      return answer([...b, ...crcA(b)]);\r\n    }\r\n    if (data[0] === 0xa0) { // WRITE (then 16 bytes)\r\n      if (tag.auth !== sector(data[1]) || data[1] === 0) return answer([0x04], 4);\r\n      pendingWrite = data[1] & 63;\r\n      return answer([0x0a], 4);\r\n    }\r\n    return timeout();\r\n  };\r\n  const command = (c) => {\r\n    regs[0x01] = c;\r\n    if (c === 0x0f) { reset(); return; } // SoftReset\r\n    if (c === 0x03) { // CalcCRC over the FIFO\r\n      const [l, h] = crcA(fifo);\r\n      regs[0x22] = l; regs[0x21] = h;\r\n      regs[0x05] |= 0x04;\r\n      return;\r\n    }\r\n    if (c === 0x0e) { // MFAuthent: [0x60 | 0x61, block, key x6, uid x4]\r\n      const d = fifo.slice();\r\n      fifo = []; regs[0x0a] = 0;\r\n      const tag = near;\r\n      if (!tag || tag.state !== 'active') return timeout();\r\n      const trailer = Math.floor(d[1] / 4) * 4 + 3;\r\n      const key = d[0] === 0x61 ? tag.mem.slice(trailer * 16 + 10, trailer * 16 + 16) : tag.mem.slice(trailer * 16, trailer * 16 + 6);\r\n      if (d.slice(2, 8).join() === key.join() && d.slice(8, 12).join() === tag.u.join()) {\r\n        tag.auth = Math.floor(d[1] / 4);\r\n        regs[0x08] |= 0x08; // MFCrypto1On\r\n        irq(0x10);\r\n      } else timeout();\r\n    }\r\n  };\r\n  const write = (reg, v) => {\r\n    if (reg === 0x09) { if (fifo.length < 64) fifo.push(v); regs[0x0a] = fifo.length; return; }\r\n    if (reg === 0x0a) { if (v & 0x80) { fifo = []; regs[0x0a] = 0; } return; }\r\n    if (reg === 0x04) { regs[0x04] = v & 0x80 ? regs[0x04] | (v & 0x7f) : regs[0x04] & ~(v & 0x7f); return; } // ComIrqReg: bit 7 says set or clear\r\n    if (reg === 0x05) { regs[0x05] = v & 0x80 ? regs[0x05] | (v & 0x7f) : regs[0x05] & ~(v & 0x7f); return; }\r\n    if (reg === 0x01) { command(v & 0x0f); return; }\r\n    regs[reg] = v;\r\n    if (reg === 0x0d && (v & 0x80) && (regs[0x01] & 0x0f) === 0x0c) { regs[0x0d] &= 0x7f; transceive(); }\r\n  };\r\n  const read = (reg) => {\r\n    if (reg === 0x09) { const b = fifo.shift() ?? 0; regs[0x0a] = fifo.length; return b; }\r\n    return regs[reg];\r\n  };\r\n  return {\r\n    spi: {\r\n      // each transfer is one transaction (as MFRC522.h sends them): an address byte, then data\r\n      transfer(bytes) {\r\n        if (!powered) return bytes.map(() => 0);\r\n        const out = [0];\r\n        const a = bytes[0] ?? 0;\r\n        const reg = (a >> 1) & 0x3f;\r\n        if (a & 0x80) {\r\n          // a read: each following byte's answer is the register named by the byte before it\r\n          for (let i = 1; i < bytes.length; i++) {\r\n            out.push(read(((bytes[i - 1] >> 1) & 0x3f)));\r\n          }\r\n          reads++;\r\n        } else {\r\n          for (let i = 1; i < bytes.length; i++) { write(reg, bytes[i]); out.push(0); }\r\n        }\r\n        return out;\r\n      },\r\n    },\r\n    step(io) {\r\n      const v = io.supply('3.3V', 'GND');\r\n      const on = v >= 2.5 && io.level('RST') !== 0;\r\n      if (on && !powered) reset();\r\n      powered = on;\r\n      // the tag held up: from the run panel, else the nearest real one within 4 cm of the coil\r\n      for (const k of hold.take()) held = k === 'Take away' ? null : k;\r\n      let best = null;\r\n      if (held) best = panel[held];\r\n      else {\r\n        const m = part.motion();\r\n        // (the coil: the board's middle, 0.9 cm towards the far end; a tag lying on it is 0.1-1 cm above)\r\n        let bd = 4.5;\r\n        for (const t of tags.values()) {\r\n          if (!t.pos) continue;\r\n          const d = Math.hypot(t.pos[0] - m.pos[0], t.pos[1] - m.pos[1], t.pos[2] - m.pos[2] - 0.9);\r\n          if (d < bd) { bd = d; best = t; }\r\n        }\r\n      }\r\n      if (best !== near) {\r\n        if (near) { near.state = 'idle'; near.halted = false; near.auth = -1; }\r\n        near = best;\r\n        if (near) lastTagName = near.name;\r\n      }\r\n      io.drive('IRQ', powered ? (regs[0x04] & regs[0x02] & 0x7f ? 0 : v) : 0, 1);\r\n      io.draw(powered ? 0.013 : 0);\r\n    },\r\n    status() {\r\n      if (!powered) return ['no power (3.3V, RST high)'];\r\n      const ant = (regs[0x14] & 3) === 3;\r\n      return [`${near ? `a tag in its field: ${lastTagName}` : 'no tag near'}${ant ? '' : ' (antenna off: rfid.PCD_Init())'}`, `${reads} register reads`];\r\n    },\r\n  };\r\n});\r\n","sketch":{"MFRC522.h":{"classes":["MFRC522"],"code":"// MFRC522.h (miguelbalboa's library), the parts most sketches use:\r\n//   MFRC522 rfid(SS_PIN, RST_PIN);  SPI.begin();  rfid.PCD_Init();  rfid.PCD_DumpVersionToSerial();\r\n//   if (rfid.PICC_IsNewCardPresent() && rfid.PICC_ReadCardSerial()) { rfid.uid.uidByte[i], rfid.uid.size }\r\n//   rfid.PICC_GetType(rfid.uid.sak), rfid.PICC_GetTypeName(type), rfid.PICC_HaltA(), rfid.PCD_StopCrypto1()\r\n//   MFRC522::MIFARE_Key key;  key.keyByte[i] = 0xFF;\r\n//   rfid.PCD_Authenticate(MFRC522::PICC_CMD_MF_AUTH_KEY_A, block, &key, &(rfid.uid)) == MFRC522::STATUS_OK\r\n//   rfid.MIFARE_Read(block, buffer, &size) (size >= 18), rfid.MIFARE_Write(block, buffer, 16)\r\n// It talks to the chip's registers over SPI as the real library does: one transfer per register access.\r\nclass MFRC522 {\r\n  constructor(ss = 10, rst = 9) {\r\n    this.ss = ss; this.rst = rst;\r\n    this.uid = { size: 0, uidByte: new Array(10).fill(0), sak: 0 };\r\n  }\r\n  // ---- registers\r\n  _x(bytes) {\r\n    digitalWrite(this.ss, LOW);\r\n    const r = SPI.transfer(bytes.slice());\r\n    digitalWrite(this.ss, HIGH);\r\n    return r;\r\n  }\r\n  PCD_WriteRegister(reg, v) {\r\n    if (Array.isArray(v) || (v && typeof v === 'object')) { const n = arguments[2] ?? v.length; this._x([(reg << 1) & 0x7e, ...Array.from(v).slice(0, n)]); return; }\r\n    this._x([(reg << 1) & 0x7e, v & 255]);\r\n  }\r\n  PCD_ReadRegister(reg, n) {\r\n    if (n === undefined) return this._x([0x80 | ((reg << 1) & 0x7e), 0])[1];\r\n    const a = 0x80 | ((reg << 1) & 0x7e);\r\n    const r = this._x([...new Array(n).fill(a), 0]);\r\n    return r.slice(1);\r\n  }\r\n  PCD_SetRegisterBitMask(reg, mask) { this.PCD_WriteRegister(reg, this.PCD_ReadRegister(reg) | mask); }\r\n  PCD_ClearRegisterBitMask(reg, mask) { this.PCD_WriteRegister(reg, this.PCD_ReadRegister(reg) & ~mask & 255); }\r\n  // ---- the chip\r\n  PCD_Init(ss, rst) {\r\n    if (ss !== undefined) this.ss = ss;\r\n    if (rst !== undefined) this.rst = rst;\r\n    pinMode(this.ss, OUTPUT);\r\n    digitalWrite(this.ss, HIGH);\r\n    if (this.rst >= 0 && this.rst !== 255) { pinMode(this.rst, OUTPUT); digitalWrite(this.rst, LOW); delay(1); digitalWrite(this.rst, HIGH); delay(50); }\r\n    else this.PCD_Reset();\r\n    this.PCD_WriteRegister(0x12, 0x00); // TxModeReg\r\n    this.PCD_WriteRegister(0x13, 0x00); // RxModeReg\r\n    this.PCD_WriteRegister(0x24, 0x26); // ModWidthReg\r\n    this.PCD_WriteRegister(0x2a, 0x80); // TModeReg: timer starts on its own\r\n    this.PCD_WriteRegister(0x2b, 0xa9); // TPrescaler\r\n    this.PCD_WriteRegister(0x2c, 0x03); this.PCD_WriteRegister(0x2d, 0xe8); // 25 ms timeout\r\n    this.PCD_WriteRegister(0x15, 0x40); // TxASKReg: 100 % ASK\r\n    this.PCD_WriteRegister(0x11, 0x3d); // ModeReg: CRC preset 0x6363\r\n    this.PCD_AntennaOn();\r\n  }\r\n  PCD_Reset() { this.PCD_WriteRegister(0x01, 0x0f); delay(50); }\r\n  PCD_AntennaOn() { const v = this.PCD_ReadRegister(0x14); if ((v & 3) !== 3) this.PCD_WriteRegister(0x14, v | 3); }\r\n  PCD_AntennaOff() { this.PCD_ClearRegisterBitMask(0x14, 0x03); }\r\n  PCD_SetAntennaGain() {}\r\n  PCD_GetAntennaGain() { return 0x40; }\r\n  PCD_PerformSelfTest() { return this.PCD_ReadRegister(0x37) === 0x92 || this.PCD_ReadRegister(0x37) === 0x91; }\r\n  PCD_DumpVersionToSerial() {\r\n    const v = this.PCD_ReadRegister(0x37);\r\n    Serial.print('Firmware Version: 0x');\r\n    Serial.print(v, HEX);\r\n    if (v === 0x92) Serial.println(' = v2.0');\r\n    else if (v === 0x91) Serial.println(' = v1.0');\r\n    else Serial.println(' = (unknown)');\r\n    if (v === 0x00 || v === 0xff) Serial.println('WARNING: Communication failure, is the MFRC522 properly connected?');\r\n  }\r\n  PCD_CalculateCRC(data, len, result) {\r\n    this.PCD_WriteRegister(0x01, 0x00); // Idle\r\n    this.PCD_WriteRegister(0x05, 0x04); // clear CRCIRq\r\n    this.PCD_WriteRegister(0x0a, 0x80); // flush\r\n    this.PCD_WriteRegister(0x09, Array.from(data).slice(0, len));\r\n    this.PCD_WriteRegister(0x01, 0x03); // CalcCRC\r\n    for (let i = 0; i < 50; i++) {\r\n      if (this.PCD_ReadRegister(0x05) & 0x04) {\r\n        this.PCD_WriteRegister(0x01, 0x00);\r\n        result[0] = this.PCD_ReadRegister(0x22);\r\n        result[1] = this.PCD_ReadRegister(0x21);\r\n        return MFRC522.STATUS_OK;\r\n      }\r\n    }\r\n    return MFRC522.STATUS_TIMEOUT;\r\n  }\r\n  /** send bytes to the tag and get its answer (the real library's PCD_CommunicateWithPICC) */\r\n  _talk(command, waitIRq, send, back, validBits = 0, checkCRC = false) {\r\n    this.PCD_WriteRegister(0x01, 0x00);\r\n    this.PCD_WriteRegister(0x04, 0x7f);\r\n    this.PCD_WriteRegister(0x0a, 0x80);\r\n    this.PCD_WriteRegister(0x09, send);\r\n    this.PCD_WriteRegister(0x0d, validBits & 7);\r\n    this.PCD_WriteRegister(0x01, command);\r\n    if (command === 0x0c) this.PCD_SetRegisterBitMask(0x0d, 0x80);\r\n    const until = millis() + 36;\r\n    let n = 0;\r\n    for (;;) {\r\n      n = this.PCD_ReadRegister(0x04);\r\n      if (n & waitIRq) break;\r\n      if (n & 0x01) return { status: MFRC522.STATUS_TIMEOUT };\r\n      if (millis() > until) return { status: MFRC522.STATUS_TIMEOUT };\r\n    }\r\n    const err = this.PCD_ReadRegister(0x06);\r\n    if (err & 0x13) return { status: MFRC522.STATUS_ERROR };\r\n    let data = [], bits = 0;\r\n    if (back) {\r\n      const len = this.PCD_ReadRegister(0x0a);\r\n      if (len) data = this.PCD_ReadRegister(0x09, len);\r\n      bits = this.PCD_ReadRegister(0x0c) & 7;\r\n    }\r\n    if (err & 0x08) return { status: MFRC522.STATUS_COLLISION };\r\n    if (back && checkCRC) {\r\n      if (data.length === 1 && bits === 4) return { status: MFRC522.STATUS_MIFARE_NACK };\r\n      if (data.length < 2) return { status: MFRC522.STATUS_CRC_WRONG };\r\n      const c = [0, 0];\r\n      if (this.PCD_CalculateCRC(data, data.length - 2, c) !== MFRC522.STATUS_OK) return { status: MFRC522.STATUS_TIMEOUT };\r\n      if (data[data.length - 2] !== c[0] || data[data.length - 1] !== c[1]) return { status: MFRC522.STATUS_CRC_WRONG };\r\n    }\r\n    return { status: MFRC522.STATUS_OK, data, bits };\r\n  }\r\n  // ---- tags\r\n  PICC_RequestA(buffer, size) { return this._reqa(0x26, buffer); }\r\n  PICC_WakeupA(buffer, size) { return this._reqa(0x52, buffer); }\r\n  _reqa(cmd, buffer) {\r\n    this.PCD_ClearRegisterBitMask(0x0e, 0x80);\r\n    const r = this._talk(0x0c, 0x30, [cmd], true, 7);\r\n    if (r.status !== MFRC522.STATUS_OK) return r.status;\r\n    if (r.data.length !== 2 || r.bits !== 0) return MFRC522.STATUS_ERROR;\r\n    if (buffer && typeof buffer === 'object' && !isRef(buffer)) { buffer[0] = r.data[0]; buffer[1] = r.data[1]; }\r\n    return MFRC522.STATUS_OK;\r\n  }\r\n  PICC_IsNewCardPresent() {\r\n    this.PCD_WriteRegister(0x12, 0x00); this.PCD_WriteRegister(0x13, 0x00); this.PCD_WriteRegister(0x24, 0x26);\r\n    const s = this.PICC_RequestA([0, 0]);\r\n    return s === MFRC522.STATUS_OK || s === MFRC522.STATUS_COLLISION;\r\n  }\r\n  PICC_Select(uid) {\r\n    const u = uid ?? this.uid;\r\n    let r = this._talk(0x0c, 0x30, [0x93, 0x20], true);\r\n    if (r.status !== MFRC522.STATUS_OK) return r.status;\r\n    if (r.data.length < 5 || (r.data[0] ^ r.data[1] ^ r.data[2] ^ r.data[3]) !== r.data[4]) return MFRC522.STATUS_ERROR;\r\n    const id = r.data.slice(0, 4);\r\n    const frame = [0x93, 0x70, ...id, r.data[4]];\r\n    const c = [0, 0];\r\n    this.PCD_CalculateCRC(frame, 7, c);\r\n    r = this._talk(0x0c, 0x30, [...frame, c[0], c[1]], true, 0, true);\r\n    if (r.status !== MFRC522.STATUS_OK) return r.status;\r\n    u.size = 4;\r\n    for (let i = 0; i < 4; i++) u.uidByte[i] = id[i];\r\n    u.sak = r.data[0];\r\n    return MFRC522.STATUS_OK;\r\n  }\r\n  PICC_ReadCardSerial() { return this.PICC_Select(this.uid) === MFRC522.STATUS_OK; }\r\n  PICC_HaltA() {\r\n    const c = [0, 0];\r\n    this.PCD_CalculateCRC([0x50, 0x00], 2, c);\r\n    const r = this._talk(0x0c, 0x30, [0x50, 0x00, c[0], c[1]], false);\r\n    return r.status === MFRC522.STATUS_TIMEOUT ? MFRC522.STATUS_OK : MFRC522.STATUS_ERROR; // (silence means it halted)\r\n  }\r\n  PCD_Authenticate(cmd, block, key, uid) {\r\n    const u = uid ?? this.uid;\r\n    const k = key?.keyByte ?? [0xff, 0xff, 0xff, 0xff, 0xff, 0xff];\r\n    const r = this._talk(0x0e, 0x10, [cmd, block, ...Array.from(k).slice(0, 6), ...u.uidByte.slice(0, 4)], false);\r\n    return r.status;\r\n  }\r\n  PCD_StopCrypto1() { this.PCD_ClearRegisterBitMask(0x08, 0x08); }\r\n  /** 16 bytes (and 2 of CRC) into buffer; size: handed over, at least 18 */\r\n  MIFARE_Read(block, buffer, size) {\r\n    if (Number(size) < 18) return MFRC522.STATUS_NO_ROOM;\r\n    const c = [0, 0];\r\n    this.PCD_CalculateCRC([0x30, block], 2, c);\r\n    const r = this._talk(0x0c, 0x30, [0x30, block, c[0], c[1]], true, 0, true);\r\n    if (r.status !== MFRC522.STATUS_OK) return r.status;\r\n    for (let i = 0; i < r.data.length && i < 18; i++) buffer[i] = r.data[i];\r\n    setRef(size, r.data.length);\r\n    return MFRC522.STATUS_OK;\r\n  }\r\n  MIFARE_Write(block, buffer, size = 16) {\r\n    if (Number(size) < 16) return MFRC522.STATUS_INVALID;\r\n    const c = [0, 0];\r\n    this.PCD_CalculateCRC([0xa0, block], 2, c);\r\n    let r = this._talk(0x0c, 0x30, [0xa0, block, c[0], c[1]], true);\r\n    if (r.status !== MFRC522.STATUS_OK) return r.status;\r\n    if (r.data[0] !== 0x0a) return MFRC522.STATUS_MIFARE_NACK;\r\n    const data = Array.from(buffer).slice(0, 16).map((x) => Number(x) & 255);\r\n    this.PCD_CalculateCRC(data, 16, c);\r\n    r = this._talk(0x0c, 0x30, [...data, c[0], c[1]], true);\r\n    if (r.status !== MFRC522.STATUS_OK) return r.status;\r\n    return r.data[0] === 0x0a ? MFRC522.STATUS_OK : MFRC522.STATUS_MIFARE_NACK;\r\n  }\r\n  PICC_GetType(sak) {\r\n    const s = sak & 0x7f;\r\n    return s === 0x08 ? MFRC522.PICC_TYPE_MIFARE_1K : s === 0x18 ? MFRC522.PICC_TYPE_MIFARE_4K : s === 0x09 ? MFRC522.PICC_TYPE_MIFARE_MINI : s === 0x00 ? MFRC522.PICC_TYPE_MIFARE_UL : MFRC522.PICC_TYPE_UNKNOWN;\r\n  }\r\n  static PICC_GetTypeName(t) {\r\n    return { 3: 'MIFARE Mini, 320 bytes', 4: 'MIFARE 1KB', 5: 'MIFARE 4KB', 6: 'MIFARE Ultralight or Ultralight C' }[t] ?? 'Unknown type';\r\n  }\r\n  PICC_GetTypeName(t) { return MFRC522.PICC_GetTypeName(t); }\r\n  static GetStatusCodeName(s) {\r\n    return { 0: 'Success.', 1: 'Error in communication.', 2: 'Collision detected.', 3: 'Timeout in communication.', 4: 'A buffer is not big enough.', 5: 'Internal error in the code. Should not happen.', 6: 'Invalid argument.', 7: 'The CRC_A does not match.', 255: 'A MIFARE PICC responded with NAK.' }[s] ?? 'Unknown error';\r\n  }\r\n  GetStatusCodeName(s) { return MFRC522.GetStatusCodeName(s); }\r\n  PICC_DumpDetailsToSerial(uid) {\r\n    const u = uid ?? this.uid;\r\n    Serial.print('Card UID:');\r\n    for (let i = 0; i < u.size; i++) { Serial.print(u.uidByte[i] < 0x10 ? ' 0' : ' '); Serial.print(u.uidByte[i], HEX); }\r\n    Serial.println();\r\n    Serial.print('PICC type: ');\r\n    Serial.println(this.PICC_GetTypeName(this.PICC_GetType(u.sak)));\r\n  }\r\n  PICC_DumpToSerial(uid) { this.PICC_DumpDetailsToSerial(uid); this.PICC_HaltA(); }\r\n}\r\nMFRC522.STATUS_OK = 0; MFRC522.STATUS_ERROR = 1; MFRC522.STATUS_COLLISION = 2; MFRC522.STATUS_TIMEOUT = 3;\r\nMFRC522.STATUS_NO_ROOM = 4; MFRC522.STATUS_INTERNAL_ERROR = 5; MFRC522.STATUS_INVALID = 6; MFRC522.STATUS_CRC_WRONG = 7; MFRC522.STATUS_MIFARE_NACK = 0xff;\r\nMFRC522.PICC_CMD_MF_AUTH_KEY_A = 0x60; MFRC522.PICC_CMD_MF_AUTH_KEY_B = 0x61;\r\nMFRC522.PICC_TYPE_UNKNOWN = 0; MFRC522.PICC_TYPE_MIFARE_MINI = 3; MFRC522.PICC_TYPE_MIFARE_1K = 4; MFRC522.PICC_TYPE_MIFARE_4K = 5; MFRC522.PICC_TYPE_MIFARE_UL = 6;\r\nMFRC522.MIFARE_Key = class { constructor() { this.keyByte = [0xff, 0xff, 0xff, 0xff, 0xff, 0xff]; } };\r\nMFRC522.Uid = class { constructor() { this.size = 0; this.uidByte = new Array(10).fill(0); this.sak = 0; } };\r\nMFRC522.StatusCode = class {};\r\nMFRC522.PICC_Type = class {};\r\n"}},"parts":[{"id":"rc522","name":"RFID reader (RC522)","description":"SPI: SDA is its chip select (to any pin), SCK, MOSI, MISO to the board's SPI pins, RST to a pin, 3.3V (not 5 V!), GND. It reads a tag held within about 4 cm of its coil. #include <SPI.h> and <MFRC522.h>; MFRC522 rfid(SS_PIN, RST_PIN); SPI.begin(); rfid.PCD_Init(); then rfid.PICC_IsNewCardPresent() && rfid.PICC_ReadCardSerial(): rfid.uid.uidByte[0..3]. The run panel can hold up a tag too.","swatch":"#1d4fb8","mass":6,"shape":[{"box":[4,0.16,6],"at":[0,0.08,0.3],"color":"#1d4fb8"},{"box":[3,0.02,3.6],"at":[0,0.17,0.9],"color":"#c9a050","collide":false},{"box":[2.6,0.03,3.2],"at":[0,0.175,0.9],"color":"#1d4fb8","collide":false},{"box":[0.5,0.12,0.5],"at":[0,0.22,-1.6],"color":"#141416"}],"pinRows":[{"ids":["SDA","SCK","MOSI","MISO","IRQ","GND","RST","3.3V"],"at":[-0.889,0,-2.5],"kinds":{"SDA":"in","SCK":"in","MOSI":"in","MISO":"out","IRQ":"out","GND":"gnd","RST":"in","3.3V":"vin"},"extra":{"SDA":{"label":"SDA (chip select)"},"3.3V":{"label":"3.3V (not 5 V)","vmin":2.5,"vmax":3.6},"RST":{"label":"RST (LOW = off)","pulled":"up"}}}],"spi":{"sck":"SCK","mosi":"MOSI","miso":"MISO","cs":"SDA"},"controls":[{"id":"hold","kind":"keys","label":"Hold up a tag","keys":["Card 1","Card 2","Take away"],"cols":3}],"device":"rc522"},{"id":"card","name":"RFID card (MIFARE 1K)","description":"A white card with a chip and a coil. Drag it onto the reader's coil to read it. Each card has its own 4-byte ID (set it below, as hex).","swatch":"#f4f4f2","mass":5,"params":[{"key":"uid","label":"ID (8 hex digits)","kind":"number","min":0,"max":4294967295,"step":1}],"defaults":{"uid":3735928559},"shape":[{"box":[5.4,0.08,8.6],"at":[0,0.04,0],"color":"#f4f4f2"},{"box":[1,0.01,1],"at":[1.5,0.085,-2.8],"color":"#c9a050","collide":false}],"device":"tag"},{"id":"fob","name":"RFID key fob (MIFARE 1K)","description":"A blue key fob: the same chip as the card, in a little case. Drag it onto the reader's coil.","swatch":"#2a5fd0","mass":4,"params":[{"key":"uid","label":"ID (as a number)","kind":"number","min":0,"max":4294967295,"step":1}],"defaults":{"uid":2864434397},"shape":[{"box":[3,0.5,3.6],"at":[0,0.25,0],"color":"#2a5fd0"},{"cyl":[0.35,0.52],"at":[0,0.26,-1.4],"color":"#1d3f90"}],"device":"tag"}],"examples":[{"name":"Door lock","description":"Drag the key fob onto the reader: the green LED says it's let in. The white card isn't on the list: red. Its serial monitor shows each tag's ID and counts its visits in the tag's own memory (block 4).","project":{"format":"bench-workshop","version":1,"name":"Door lock","parts":[{"uid":"board","type":"maker-board","name":"Board","params":{"usb":true},"parent":null,"pos":[-12,0,0],"rot":[0,0,0,1]},{"uid":"reader","type":"rfid-rc522/rc522","name":"Reader","params":{},"parent":null,"pos":[5,0,0],"rot":[0,0,0,1],"pinned":true},{"uid":"card","type":"rfid-rc522/card","name":"White card","params":{},"parent":null,"pos":[2,0,14],"rot":[0,0,0,1]},{"uid":"fob","type":"rfid-rc522/fob","name":"Key fob","params":{},"parent":null,"pos":[12,0,12],"rot":[0,0,0,1]},{"uid":"green","type":"led","name":"Open","params":{"color":"green"},"parent":null,"pos":[-12,0,8],"rot":[0,0,0,1]},{"uid":"red","type":"led","name":"Locked","params":{"color":"red"},"parent":null,"pos":[-9,0,8],"rot":[0,0,0,1]}],"wires":[{"id":"w1","a":{"uid":"board","pin":"3V3"},"b":{"uid":"reader","pin":"3.3V"},"color":"#e04848"},{"id":"w2","a":{"uid":"board","pin":"GND"},"b":{"uid":"reader","pin":"GND"},"color":"#2b2d33"},{"id":"w3","a":{"uid":"board","pin":"GP17"},"b":{"uid":"reader","pin":"SDA"},"color":"#f08a24"},{"id":"w4","a":{"uid":"board","pin":"GP18"},"b":{"uid":"reader","pin":"SCK"},"color":"#4a90e2"},{"id":"w5","a":{"uid":"board","pin":"GP19"},"b":{"uid":"reader","pin":"MOSI"},"color":"#3cb371"},{"id":"w6","a":{"uid":"board","pin":"GP16"},"b":{"uid":"reader","pin":"MISO"},"color":"#e8c547"},{"id":"w7","a":{"uid":"board","pin":"GP15"},"b":{"uid":"reader","pin":"RST"},"color":"#f2f2f2"},{"id":"w8","a":{"uid":"board","pin":"GP13"},"b":{"uid":"green","pin":"A"},"color":"#3cb371"},{"id":"w9","a":{"uid":"board","pin":"GP14"},"b":{"uid":"red","pin":"A"},"color":"#e04848"},{"id":"w10","a":{"uid":"green","pin":"K"},"b":{"uid":"board","pin":"GND2"},"color":"#2b2d33"},{"id":"w11","a":{"uid":"red","pin":"K"},"b":{"uid":"green","pin":"K"},"color":"#2b2d33"}],"programs":{"board":{"lang":"arduino","source":"// Door lock: hold a tag to the reader (drag it onto the coil). The key fob is on the list: green.\n// Anything else: red. Each tag also counts its visits in its own memory (block 4).\n#include <SPI.h>\n#include <MFRC522.h>\n\n#define SS_PIN 17    // the reader's SDA\n#define RST_PIN 15\n#define GREEN 13\n#define RED 14\n\nMFRC522 rfid(SS_PIN, RST_PIN);\nMFRC522::MIFARE_Key key;\nbyte allowed[4] = {0xAA, 0xBB, 0xCC, 0xDD};\n\nvoid setup() {\n  Serial.begin(115200);\n  SPI.begin();\n  rfid.PCD_Init();\n  rfid.PCD_DumpVersionToSerial();\n  for (byte i = 0; i < 6; i++) key.keyByte[i] = 0xFF;   // a new tag's key\n  pinMode(GREEN, OUTPUT);\n  pinMode(RED, OUTPUT);\n  Serial.println(\"Hold a tag to the reader\");\n}\n\nvoid loop() {\n  if (!rfid.PICC_IsNewCardPresent() || !rfid.PICC_ReadCardSerial()) {\n    delay(50);\n    return;\n  }\n  Serial.print(\"Tag:\");\n  for (byte i = 0; i < rfid.uid.size; i++) {\n    Serial.print(rfid.uid.uidByte[i] < 0x10 ? \" 0\" : \" \");\n    Serial.print(rfid.uid.uidByte[i], HEX);\n  }\n  Serial.println();\n\n  bool ok = true;\n  for (byte i = 0; i < 4; i++) if (rfid.uid.uidByte[i] != allowed[i]) ok = false;\n\n  // its visits, kept in the tag itself\n  byte block = 4;\n  byte buffer[18];\n  byte size = sizeof(buffer);\n  MFRC522::StatusCode status = (MFRC522::StatusCode) rfid.PCD_Authenticate(MFRC522::PICC_CMD_MF_AUTH_KEY_A, block, &key, &(rfid.uid));\n  if (status == MFRC522::STATUS_OK) {\n    status = rfid.MIFARE_Read(block, buffer, &size);\n    if (status == MFRC522::STATUS_OK) {\n      buffer[0] = buffer[0] + 1;\n      rfid.MIFARE_Write(block, buffer, 16);\n      Serial.print(\"visits: \");\n      Serial.println(buffer[0]);\n    }\n  } else {\n    Serial.print(\"couldn't open its memory: \");\n    Serial.println(rfid.GetStatusCodeName(status));\n  }\n\n  Serial.println(ok ? \"Welcome in\" : \"Not on the list\");\n  digitalWrite(ok ? GREEN : RED, HIGH);\n  rfid.PICC_HaltA();\n  rfid.PCD_StopCrypto1();\n  delay(1500);\n  digitalWrite(GREEN, LOW);\n  digitalWrite(RED, LOW);\n}\n"}},"boards":[]}}]}