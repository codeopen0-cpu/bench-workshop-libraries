{
 "format": "bench-workshop",
 "version": 1,
 "name": "Weather to serial (DHT22)",
 "parts": [
  {"uid": "board", "type": "maker-board", "name": "Board", "params": {"usb": true}, "parent": null, "pos": [-5, 0, 0], "rot": [0, 0, 0, 1]},
  {"uid": "dht", "type": "climate-sensors/dht22", "name": "DHT22", "params": {}, "parent": null, "pos": [4, 0, 0], "rot": [0, 0, 0, 1]}
 ],
 "wires": [
  {"id": "w1", "a": {"uid": "board", "pin": "3V3"}, "b": {"uid": "dht", "pin": "VCC"}, "color": "#e04848"},
  {"id": "w2", "a": {"uid": "board", "pin": "GP2"}, "b": {"uid": "dht", "pin": "DATA"}, "color": "#e8c547"},
  {"id": "w3", "a": {"uid": "board", "pin": "GND"}, "b": {"uid": "dht", "pin": "GND"}, "color": "#2b2d33"}
 ],
 "programs": {"board": {"lang": "arduino", "source": "// Temperature and humidity from a DHT22. Move its sliders in the run panel.\n#include <DHT.h>\n\n#define DHTPIN 2\n#define DHTTYPE DHT22\n\nDHT dht(DHTPIN, DHTTYPE);\n\nvoid setup() {\n  Serial.begin(115200);\n  dht.begin();\n}\n\nvoid loop() {\n  delay(2000);   // a DHT22 measures every 2 seconds at most\n  float h = dht.readHumidity();\n  float t = dht.readTemperature();\n  if (isnan(h) || isnan(t)) {\n    Serial.println(\"No answer from the DHT22: check its wires\");\n    return;\n  }\n  float feels = dht.computeHeatIndex(t, h, false);\n  Serial.print(\"Humidity: \");\n  Serial.print(h, 1);\n  Serial.print(\" %  Temperature: \");\n  Serial.print(t, 1);\n  Serial.print(\" C  Feels like: \");\n  Serial.print(feels, 1);\n  Serial.println(\" C\");\n}\n"}},
 "boards": []
}
