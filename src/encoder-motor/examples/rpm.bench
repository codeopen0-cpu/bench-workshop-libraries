{
 "format": "bench-workshop",
 "version": 1,
 "name": "Measure the speed",
 "parts": [
  {"uid": "board", "type": "maker-board", "name": "Board", "params": {"usb": true}, "parent": null, "pos": [-8, 0, 0], "rot": [0, 0, 0, 1]},
  {"uid": "drv", "type": "drv8833", "name": "Motor driver", "params": {}, "parent": null, "pos": [0, 0, 6], "rot": [0, 0, 0, 1]},
  {"uid": "motor", "type": "encoder-motor/tt-encoder", "name": "Motor", "params": {}, "parent": null, "pos": [8, 0, 0], "rot": [0, 0, 0, 1], "pinned": true},
  {"uid": "bat", "type": "battery-4aa", "name": "Motor battery", "params": {"count": "4", "cells": "nimh", "charge": 100}, "parent": null, "pos": [0, 0, 14], "rot": [0, 0, 0, 1]}
 ],
 "wires": [
  {"id": "w1", "a": {"uid": "board", "pin": "GP6"}, "b": {"uid": "drv", "pin": "AIN1"}, "color": "#e8c547"},
  {"id": "w2", "a": {"uid": "board", "pin": "GP7"}, "b": {"uid": "drv", "pin": "AIN2"}, "color": "#4f9cff"},
  {"id": "w3", "a": {"uid": "drv", "pin": "AOUT1"}, "b": {"uid": "motor", "pin": "M+"}, "color": "#e04848"},
  {"id": "w4", "a": {"uid": "drv", "pin": "AOUT2"}, "b": {"uid": "motor", "pin": "M-"}, "color": "#2b2d33"},
  {"id": "w5", "a": {"uid": "bat", "pin": "+"}, "b": {"uid": "drv", "pin": "VM"}, "color": "#e04848"},
  {"id": "w6", "a": {"uid": "bat", "pin": "-"}, "b": {"uid": "drv", "pin": "GND"}, "color": "#2b2d33"},
  {"id": "w7", "a": {"uid": "board", "pin": "GND2"}, "b": {"uid": "drv", "pin": "GND"}, "color": "#2b2d33"},
  {"id": "w8", "a": {"uid": "board", "pin": "3V3"}, "b": {"uid": "motor", "pin": "VCC"}, "color": "#e04848"},
  {"id": "w9", "a": {"uid": "board", "pin": "GND"}, "b": {"uid": "motor", "pin": "GND"}, "color": "#2b2d33"},
  {"id": "w10", "a": {"uid": "board", "pin": "GP2"}, "b": {"uid": "motor", "pin": "OUT"}, "color": "#3fbf7f"}
 ],
 "programs": {"board": {"lang": "arduino", "source": "// Count the encoder's pulses (an interrupt on each rising edge) and work out the rpm,\n// at three speeds. 20 slots on the disc: 20 pulses a turn.\n#define ENC 2\n#define AIN1 6\n#define AIN2 7\n\nvolatile long pulses = 0;\n\nvoid onPulse() {\n  pulses++;\n}\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(AIN1, OUTPUT);\n  pinMode(AIN2, OUTPUT);\n  pinMode(ENC, INPUT);\n  attachInterrupt(digitalPinToInterrupt(ENC), onPulse, RISING);\n}\n\nvoid runAt(int power) {\n  analogWrite(AIN1, power);   // PWM: how much of the battery's volts the motor gets\n  digitalWrite(AIN2, LOW);\n  delay(500);                 // let it get up to speed\n  pulses = 0;\n  delay(1000);\n  long n = pulses;\n  Serial.print(\"power \");\n  Serial.print(power);\n  Serial.print(\": \");\n  Serial.print(n * 60 / 20);\n  Serial.println(\" rpm\");\n}\n\nvoid loop() {\n  runAt(120);\n  runAt(190);\n  runAt(255);\n  digitalWrite(AIN1, LOW);\n  Serial.println(\"stop\");\n  delay(1500);\n}\n"}},
 "boards": []
}
