  "name": "Gripper, fingerprint sensor, MP3 player, 7-segment digit",
  "version": "1.0.0",
  "author": "Bench Workshop",
  "owner": "codeopen0-cpu",
  "description": "A servo claw gripper that really grabs things, a fingerprint sensor (R307 / AS608, Adafruit_Fingerprint.h), the DFPlayer Mini MP3 player (DFRobotDFPlayerMini.h) and a single 7-segment LED digit.",
  "category": "Modules",
  "needsApp": "0.4.0",
  "code": "device.js",
  "sketch": {
    "DFRobotDFPlayerMini.h": {
      "classes": [
        "DFRobotDFPlayerMini"
      ],
      "exports": [
        "DFPlayerPlayFinished",
        "DFPlayerError",
        "DFPlayerCardInserted",
        "DFPlayerCardRemoved",
        "DFPlayerCardOnline",
        "TimeOut",
        "WrongStack",
        "DFPLAYER_EQ_NORMAL",
        "DFPLAYER_EQ_POP",
        "DFPLAYER_EQ_ROCK",
        "DFPLAYER_EQ_JAZZ",
        "DFPLAYER_EQ_CLASSIC",
        "DFPLAYER_EQ_BASS",
        "DFPLAYER_DEVICE_SD"
      ],
      "file": "sketch/DFRobotDFPlayerMini.js"
    },
    "Adafruit_Fingerprint.h": {
