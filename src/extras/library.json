  "parts": [
    {
      "id": "gripper",
      "name": "Servo gripper (claw)",
      "description": "Two jaws worked by a servo inside it (about 2.5 kg*cm): wire it like a servo (GND, V+ 4.8-6 V, SIG) and Servo.write(0) opens it wide, Servo.write(90) closes it. It really holds things: put a block between its jaws and close them, then lift the gripper while it runs. Glue it to a servo arm for a robot arm.",
      "swatch": "#2a2c31",
      "mass": 30,
      "shape": [
        {
          "box": [
            3.4,
            2.0,
            2.4
          ],
          "at": [
            0,
            1.0,
            0
          ],
          "color": "#2a2c31"
        },
        {
          "box": [
            1.2,
            1.0,
            2.2
          ],
          "at": [
            0,
            0.5,
            -2.2
          ],
          "color": "#2a62c8"
        }
      ],
      "pins": [
        {
          "id": "GND",
          "label": "GND (brown)",
          "at": [
            -0.3,
            1.0,
            -3.3
          ],
          "kind": "gnd"
        },
        {
          "id": "V+",
          "label": "V+ (red, 4.8-6 V)",
          "at": [
            0,
            1.0,
            -3.3
          ],
          "kind": "vin",
          "vmin": 4,
          "vmax": 7.2
        },
        {
          "id": "SIG",
          "label": "SIG (orange)",
          "at": [
            0.3,
            1.0,
            -3.3
          ],
          "kind": "in"
        }
      ],
      "moving": [
        {
          "id": "jawL",
