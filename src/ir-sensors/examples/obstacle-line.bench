{
 "format": "bench-workshop",
 "version": 1,
 "name": "Obstacle and line",
 "parts": [
  {"uid": "board", "type": "maker-board", "name": "Board", "params": {"usb": true}, "parent": null, "pos": [-10, 0, 0], "rot": [0, 0, 0, 1]},
  {"uid": "fc51", "type": "ir-sensors/fc51", "name": "Obstacle sensor", "params": {"range": 10}, "parent": null, "pos": [2, 0, -10], "rot": [0, 0, 0, 1], "pinned": true},
  {"uid": "wall", "type": "block", "name": "Something in the way", "params": {"w": 3, "h": 5, "d": 6, "material": "wood", "color": "#c98a4b"}, "parent": null, "pos": [10, 0, -10], "rot": [0, 0, 0, 1]},
  {"uid": "paper", "type": "plate", "name": "White paper", "params": {"w": 14, "h": 0.3, "d": 10, "material": "plastic", "color": "#f4f4f2"}, "parent": null, "pos": [6, 0, 8], "rot": [0, 0, 0, 1], "pinned": true},
  {"uid": "tape", "type": "plate", "name": "Black tape", "params": {"w": 2, "h": 0.1, "d": 10, "material": "plastic", "color": "#151515"}, "parent": {"uid": "paper", "body": "body"}, "pos": [3, 0.15, 0], "rot": [0, 0, 0, 1]},
  {"uid": "line1", "type": "ir-sensors/tcrt5000", "name": "Line sensor over the tape", "params": {"threshold": 70}, "parent": {"uid": "tape", "body": "body"}, "pos": [-1.1, 0.05, 0], "rot": [0, 0, 0, 1]},
  {"uid": "line2", "type": "ir-sensors/tcrt5000", "name": "Line sensor over paper", "params": {"threshold": 70}, "parent": {"uid": "paper", "body": "body"}, "pos": [-4, 0.15, 0], "rot": [0, 0, 0, 1]},
  {"uid": "led1", "type": "led", "name": "Obstacle LED", "params": {"color": "red"}, "parent": null, "pos": [-4, 0, -8], "rot": [0, 0, 0, 1]},
  {"uid": "led2", "type": "led", "name": "Line LED", "params": {"color": "green"}, "parent": null, "pos": [-4, 0, 6], "rot": [0, 0, 0, 1]}
 ],
 "wires": [
  {"id": "w1", "a": {"uid": "board", "pin": "3V3"}, "b": {"uid": "fc51", "pin": "VCC"}, "color": "#e04848"},
  {"id": "w2", "a": {"uid": "board", "pin": "GND"}, "b": {"uid": "fc51", "pin": "GND"}, "color": "#2b2d33"},
  {"id": "w3", "a": {"uid": "board", "pin": "GP2"}, "b": {"uid": "fc51", "pin": "OUT"}, "color": "#e8c547"},
  {"id": "w4", "a": {"uid": "board", "pin": "3V3"}, "b": {"uid": "line1", "pin": "VCC"}, "color": "#e04848"},
  {"id": "w5", "a": {"uid": "board", "pin": "GND"}, "b": {"uid": "line1", "pin": "GND"}, "color": "#2b2d33"},
  {"id": "w6", "a": {"uid": "board", "pin": "GP3"}, "b": {"uid": "line1", "pin": "DO"}, "color": "#3fbf7f"},
  {"id": "w7", "a": {"uid": "board", "pin": "3V3"}, "b": {"uid": "line2", "pin": "VCC"}, "color": "#e04848"},
  {"id": "w8", "a": {"uid": "board", "pin": "GND2"}, "b": {"uid": "line2", "pin": "GND"}, "color": "#2b2d33"},
  {"id": "w9", "a": {"uid": "board", "pin": "GP4"}, "b": {"uid": "line2", "pin": "DO"}, "color": "#4f9cff"},
  {"id": "w10", "a": {"uid": "board", "pin": "GP14"}, "b": {"uid": "led1", "pin": "A"}, "color": "#f08c2a"},
  {"id": "w11", "a": {"uid": "board", "pin": "GND2"}, "b": {"uid": "led1", "pin": "K"}, "color": "#2b2d33"},
  {"id": "w12", "a": {"uid": "board", "pin": "GP15"}, "b": {"uid": "led2", "pin": "A"}, "color": "#f08c2a"},
  {"id": "w13", "a": {"uid": "board", "pin": "GND2"}, "b": {"uid": "led2", "pin": "K"}, "color": "#2b2d33"}
 ],
 "programs": {"board": {"lang": "arduino", "source": "// The red LED lights when something is in front of the obstacle sensor;\n// the green one when the first line sensor is over the black tape.\n#define OBSTACLE 2   // FC-51 OUT: LOW = something there\n#define LINE_A 3     // TCRT5000 DO: HIGH = dark\n#define LINE_B 4\n#define RED 14\n#define GREEN 15\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(OBSTACLE, INPUT);\n  pinMode(LINE_A, INPUT);\n  pinMode(LINE_B, INPUT);\n  pinMode(RED, OUTPUT);\n  pinMode(GREEN, OUTPUT);\n}\n\nvoid loop() {\n  bool blocked = digitalRead(OBSTACLE) == LOW;\n  bool onLineA = digitalRead(LINE_A) == HIGH;\n  bool onLineB = digitalRead(LINE_B) == HIGH;\n  digitalWrite(RED, blocked);\n  digitalWrite(GREEN, onLineA);\n  Serial.print(blocked ? \"blocked\" : \"clear\");\n  Serial.print(\"  sensor A: \");\n  Serial.print(onLineA ? \"line\" : \"paper\");\n  Serial.print(\"  sensor B: \");\n  Serial.println(onLineB ? \"line\" : \"paper\");\n  delay(500);\n}\n"}},
 "boards": []
}
