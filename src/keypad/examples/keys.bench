{
 "format": "bench-workshop",
 "version": 1,
 "name": "Keypad to serial",
 "parts": [
  {"uid": "board", "type": "maker-board", "name": "Board", "params": {"usb": true}, "parent": null, "pos": [-6, 0, -6], "rot": [0, 0, 0, 1]},
  {"uid": "pad", "type": "keypad/keypad4x4", "name": "Keypad", "params": {}, "parent": null, "pos": [6, 0, 2], "rot": [0, 0, 0, 1]}
 ],
 "wires": [
  {"id": "w1", "a": {"uid": "board", "pin": "GP9"}, "b": {"uid": "pad", "pin": "R1"}, "color": "#e04848"},
  {"id": "w2", "a": {"uid": "board", "pin": "GP8"}, "b": {"uid": "pad", "pin": "R2"}, "color": "#f08c2a"},
  {"id": "w3", "a": {"uid": "board", "pin": "GP7"}, "b": {"uid": "pad", "pin": "R3"}, "color": "#e8c547"},
  {"id": "w4", "a": {"uid": "board", "pin": "GP6"}, "b": {"uid": "pad", "pin": "R4"}, "color": "#3fbf7f"},
  {"id": "w5", "a": {"uid": "board", "pin": "GP5"}, "b": {"uid": "pad", "pin": "C1"}, "color": "#4f9cff"},
  {"id": "w6", "a": {"uid": "board", "pin": "GP4"}, "b": {"uid": "pad", "pin": "C2"}, "color": "#9b59d6"},
  {"id": "w7", "a": {"uid": "board", "pin": "GP3"}, "b": {"uid": "pad", "pin": "C3"}, "color": "#9aa1b2"},
  {"id": "w8", "a": {"uid": "board", "pin": "GP2"}, "b": {"uid": "pad", "pin": "C4"}, "color": "#f2f2f2"}
 ],
 "programs": {"board": {"lang": "arduino", "source": "// Which key? Press keys in the run panel (select the keypad's card on the right).\n#include <Keypad.h>\n\nconst byte ROWS = 4;\nconst byte COLS = 4;\nchar keys[ROWS][COLS] = {\n  {'1', '2', '3', 'A'},\n  {'4', '5', '6', 'B'},\n  {'7', '8', '9', 'C'},\n  {'*', '0', '#', 'D'}\n};\nbyte rowPins[ROWS] = {9, 8, 7, 6};   // R1-R4\nbyte colPins[COLS] = {5, 4, 3, 2};   // C1-C4\n\nKeypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);\n\nvoid setup() {\n  Serial.begin(115200);\n  Serial.println(\"Press a key\");\n}\n\nvoid loop() {\n  char key = keypad.getKey();\n  if (key) {\n    Serial.print(\"key: \");\n    Serial.println(key);\n  }\n}\n"}},
 "boards": []
}
