 "programs": {
  "board": {
   "lang": "arduino",
   "source": "// Hello, LCD: Arduino's LiquidCrystal \"Hello World\", on the bench.\n// The LCD shows a greeting on line 1 and the seconds since start on line 2.\n// Wiring (as in the Arduino example): RS -> 12, E -> 11, D4 -> 5, D5 -> 4, D6 -> 3, D7 -> 2,\n// VSS and RW and K -> GND, VDD and A -> 5V, V0 -> the knob's middle leg (its ends on 5V and GND).\n// Faint or no text? Turn the knob (right panel while running) towards GND: that's the contrast.\n#include <LiquidCrystal.h>\n\nLiquidCrystal lcd(12, 11, 5, 4, 3, 2);   // rs, enable, d4, d5, d6, d7\n\nvoid setup() {\n  lcd.begin(16, 2);          // 16 columns, 2 rows\n  lcd.print(\"Hello, world!\");\n}\n\nvoid loop() {\n  int seconds = millis() / 1000;\n  lcd.setCursor(0, 1);       // column 0, row 1 (the second line)\n  lcd.print(seconds);\n  lcd.print(\" s\");\n  delay(250);\n}\n"
  }
 },
 "boards": []
}