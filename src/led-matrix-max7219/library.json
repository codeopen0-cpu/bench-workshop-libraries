    "LedControl.h": { "classes": ["LedControl"], "file": "sketch/LedControl.js" }
  },
  "parts": [
    {
      "id": "matrix8x8",
      "name": "LED matrix 8x8 (MAX7219)",
      "description": "64 red LEDs driven by a MAX7219. Wire VCC to 5 V, GND, and DIN / CS / CLK to any three pins; in a sketch: #include <LedControl.h>, LedControl lc(DIN, CLK, CS, 1); lc.shutdown(0, false); lc.setLed(0, row, col, true);",
      "swatch": "#d0302a",
      "mass": 12,
      "shape": [
        { "box": [3.25, 0.16, 5.0], "at": [0, 0.08, 0], "color": "#1f5fbf" },
        { "box": [3.2, 0.75, 3.2], "at": [0, 0.535, -0.6], "color": "#1b1b1d" },
        { "screen": { "id": "leds", "size": [3.1, 3.1], "px": [8, 8], "on": "#ff3a2a", "off": "#2a0e0c", "bg": "#151517" }, "at": [0, 0.912, -0.6] },
        { "box": [0.7, 0.1, 0.7], "at": [0, 0.21, 1.55], "color": "#151618", "collide": false }
      ],
      "pinRows": [
        {
          "ids": ["VCC", "GND", "DIN", "CS", "CLK"],
          "at": [-0.508, 0.16, 2.3],
          "kinds": { "VCC": "vin", "GND": "gnd", "DIN": "in", "CS": "in", "CLK": "in" },
          "extra": { "VCC": { "label": "VCC (4-5.5 V)", "vmin": 4, "vmax": 5.5 } }
        }
      ],
      "device": "max7219"
    }
  ]
}
