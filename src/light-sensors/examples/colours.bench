 "programs": {
  "board": {
   "lang": "arduino",
   "source": "// Colour names: the TCS34725 looks down from the arm at the white paper. Drag a coloured block\n// under it.\n#include <Wire.h>\n#include <Adafruit_TCS34725.h>\n\nAdafruit_TCS34725 tcs = Adafruit_TCS34725(TCS34725_INTEGRATIONTIME_50MS, TCS34725_GAIN_4X);\n\nString nameOf(float r, float g, float b, uint16_t c) {\n  if (c < 300) return \"nothing (too dark)\";\n  if (r > 0.33 && g > 0.33 && b < 0.25) return \"yellow\";   // (red and green together, little blue)\n  if (r > 0.27 && g > 0.27 && b > 0.27 && max(r, max(g, b)) < 0.42) return \"white (just the paper?)\";\n  if (r > g && r > b) return \"red\";\n  if (g > r && g > b) return \"green\";\n  return \"blue\";\n}\n\nvoid setup() {\n  Serial.begin(115200);\n  Wire.begin();\n  if (!tcs.begin()) {\n    Serial.println(\"No TCS34725: check its wires\");\n    while (true) delay(100);\n  }\n}\n\nString last = \"\";\n\nvoid loop() {\n  uint16_t r, g, b, c;\n  tcs.getRawData(&r, &g, &b, &c);\n  float sum = r + g + b;\n  if (sum < 1) sum = 1;\n  String name = nameOf(r / sum, g / sum, b / sum, c);\n  if (name != last) {\n    Serial.print(\"I see \");\n    Serial.print(name);\n    Serial.print(\"  (r \");\n    Serial.print(r);\n    Serial.print(\", g \");\n    Serial.print(g);\n    Serial.print(\", b \");\n    Serial.print(b);\n    Serial.println(\")\");\n    last = name;\n  }\n  delay(200);\n}\n"
  }
 },
 "boards": []
}