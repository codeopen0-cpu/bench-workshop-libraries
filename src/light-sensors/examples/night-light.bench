 "programs": {
  "board": {
   "lang": "arduino",
   "source": "// Night light: the LED comes on when the light sensor says it's dark. Press the toolbar's Room\n// button to dim the room, or drag the box over the sensor. The light meter prints lux (Plot them).\n#include <Wire.h>\n#include <BH1750.h>\n\n#define DARK 2      // the LDR module's DO: HIGH when dark\n#define LEVEL A0    // its AO: higher when darker\n#define LAMP 15\n\nBH1750 meter;\n\nvoid setup() {\n  Serial.begin(115200);\n  Wire.begin();\n  meter.begin();\n  pinMode(DARK, INPUT);\n  pinMode(LAMP, OUTPUT);\n}\n\nvoid loop() {\n  bool dark = digitalRead(DARK) == HIGH;\n  digitalWrite(LAMP, dark ? HIGH : LOW);\n  float lux = meter.readLightLevel();\n  Serial.print(\"lux:\");\n  Serial.print(lux, 0);\n  Serial.print(\" ldr:\");\n  Serial.println(analogRead(LEVEL));\n  delay(400);\n}\n"
  }
 },
 "boards": []
}