 "programs": {
  "board": {
   "lang": "arduino",
   "source": "// Compass and tilt alarm. Pick the yellow sensor board up (drag it), turn it with Q / E: the heading\n// changes. Tip it over (or drop it on its side) and the alarm LED lights.\n#include <Wire.h>\n#include <QMC5883LCompass.h>\n\n#define TILT 2\n#define ALARM 15\n\nQMC5883LCompass compass;\n\nvoid setup() {\n  Serial.begin(115200);\n  Wire.begin();\n  compass.init();\n  pinMode(TILT, INPUT);\n  pinMode(ALARM, OUTPUT);\n}\n\nvoid loop() {\n  compass.read();\n  int heading = compass.getAzimuth();\n  if (heading < 0) heading += 360;\n  char dir[3];\n  compass.getDirection(dir, heading);\n\n  bool tipped = digitalRead(TILT) == HIGH;\n  digitalWrite(ALARM, tipped ? HIGH : LOW);\n\n  Serial.print(\"heading \");\n  Serial.print(heading);\n  Serial.print(\" deg (\");\n  Serial.print(dir[0]);\n  Serial.print(dir[1]);\n  Serial.print(dir[2]);\n  Serial.print(\")\");\n  if (tipped) Serial.print(\"  TIPPED OVER!\");\n  Serial.println();\n  delay(300);\n}\n"
  }
 },
 "boards": []
}