 "programs": {
  "tx": {
   "lang": "arduino",
   "source": "// Radio remote, the sending end: turn the knob (its slider in the run panel); the angle goes out by\n// radio 20 times a second. radio.write() says whether the other end got it.\n#include <SPI.h>\n#include <RF24.h>\n\nRF24 radio(14, 17);            // CE, CSN\nconst byte address[6] = \"00001\";\nint sent = 0, lost = 0;\n\nvoid setup() {\n  Serial.begin(115200);\n  if (!radio.begin()) {\n    Serial.println(\"The radio isn't answering: check its wires (and 3.3 V)\");\n    while (true) delay(100);\n  }\n  radio.openWritingPipe(address);\n  radio.setPALevel(RF24_PA_LOW);\n  radio.stopListening();\n}\n\nvoid loop() {\n  int angle = map(analogRead(A0), 0, 4095, 0, 180);\n  bool ok = radio.write(&angle, sizeof(angle));\n  if (ok) sent++; else lost++;\n  if ((sent + lost) % 20 == 0) {\n    Serial.print(\"angle \");\n    Serial.print(angle);\n    Serial.print(\"   got there: \");\n    Serial.print(sent);\n    Serial.print(\"   lost: \");\n    Serial.println(lost);\n  }\n  delay(50);\n}\n"
  },
  "rx": {
   "lang": "arduino",
   "source": "// Radio remote, the receiving end: each angle that arrives turns the servo.\n#include <SPI.h>\n#include <RF24.h>\n#include <Servo.h>\n\nRF24 radio(14, 17);            // CE, CSN\nconst byte address[6] = \"00001\";\nServo servo;\n\nvoid setup() {\n  Serial.begin(115200);\n  if (!radio.begin()) {\n    Serial.println(\"The radio isn't answering: check its wires (and 3.3 V)\");\n    while (true) delay(100);\n  }\n  radio.openReadingPipe(0, address);\n  radio.setPALevel(RF24_PA_LOW);\n  radio.startListening();\n  servo.attach(15);\n}\n\nint last = -1;\n\nvoid loop() {\n  if (radio.available()) {\n    int angle = 0;\n    radio.read(&angle, sizeof(angle));\n    servo.write(angle);\n    if (angle != last) {\n      Serial.print(\"angle: \");\n      Serial.println(angle);\n      last = angle;\n    }\n  }\n}\n"
  }
 },
