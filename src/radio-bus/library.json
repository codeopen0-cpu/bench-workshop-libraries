 "author": "Bench Workshop",
 "owner": "codeopen0-cpu",
 "description": "Talking further and tougher: a LoRa radio (SX1278, long range, slow; LoRa.h), a CAN bus module (MCP2515 + TJA1050, as in cars; mcp_can.h) and an RS485 transceiver (MAX485, long wires in noisy places, with Serial). Radios on the same frequency and settings hear each other; CAN and RS485 modules talk over their wires.",
 "category": "Communication",
 "needsApp": "0.4.0",
 "code": "device.js",
 "sketch": {
  "LoRa.h": {
   "classes": [
    "LoRaClass"
   ],
   "exports": [
    "LoRa"
   ],
   "file": "sketch/LoRa.js"
  },
  "mcp_can.h": {
   "classes": [
    "MCP_CAN"
   ],
   "exports": [
    "CAN_OK",
    "CAN_FAILINIT",
    "CAN_FAILTX",
    "CAN_MSGAVAIL",
    "CAN_NOMSG",
    "CAN_CTRLERROR",
    "CAN_GETTXBFTIMEOUT",
    "CAN_SENDMSGTIMEOUT",
    "CAN_FAIL",
    "MCP_ANY",
    "MCP_STD",
    "MCP_EXT",
    "MCP_STDEXT",
    "MCP_NORMAL",
    "MCP_SLEEP",
    "MCP_LOOPBACK",
