       "vmin": 2.4,
       "vmax": 3.7
      },
      "NSS": {
       "label": "NSS (CS)",
       "pulled": "up"
      },
      "RST": {
       "pulled": "up"
      }
     }
    }
   ],
   "spi": {
    "sck": "SCK",
    "mosi": "MOSI",
    "miso": "MISO",
    "cs": "NSS"
   },
   "device": "lora"
  },
  {
   "id": "mcp2515",
   "name": "CAN bus module (MCP2515 + TJA1050)",
   "description": "Joins a board to a CAN bus (the two-wire network in cars and machines): wire every module's CANH together and every CANL together. SPI to the board: SCK, SI (MOSI), SO (MISO), CS; INT goes LOW while a message waits. 5 V. With #include <mcp_can.h>: MCP_CAN CAN0(10); CAN0.begin(MCP_ANY, CAN_500KBPS, MCP_8MHZ) == CAN_OK; CAN0.setMode(MCP_NORMAL); CAN0.sendMsgBuf(0x100, 0, 8, data); and if (CAN0.checkReceive() == CAN_MSGAVAIL) CAN0.readMsgBuf(&id, &len, buf). Every module on a bus must use the same speed.",
   "swatch": "#2a62c8",
   "mass": 6,
   "params": [
    {
     "key": "crystal",
     "label": "Its crystal",
     "kind": "select",
     "options": [
      {
       "value": "8",
       "label": "8 MHz (most blue modules)"
      },
      {
       "value": "16",
       "label": "16 MHz"
      }
     ]
    }
   ],
   "defaults": {
