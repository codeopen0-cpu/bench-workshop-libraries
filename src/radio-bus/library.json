      0.87
     ],
     "dir": "x",
     "kinds": {
      "GND": "gnd",
      "VCC": "vin",
      "MISO": "out",
      "MOSI": "in",
      "SCK": "in",
      "NSS": "in",
      "RST": "in",
      "DIO0": "out"
     },
     "extra": {
