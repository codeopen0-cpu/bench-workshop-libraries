    "MCP_8MHZ",
    "MCP_16MHZ",
    "MCP_20MHZ",
    "CAN_5KBPS",
    "CAN_10KBPS",
    "CAN_20KBPS",
    "CAN_50KBPS",
    "CAN_100KBPS",
    "CAN_125KBPS",
    "CAN_250KBPS",
    "CAN_500KBPS",
    "CAN_1000KBPS"
   ],
   "file": "sketch/mcp_can.js"
  }
 },
 "parts": [
  {
   "id": "lora",
   "name": "LoRa radio (SX1278, 433 MHz)",
   "description": "Long-range, slow radio (kilometres outdoors; a few hundred bytes a second). SPI: SCK, MISO, MOSI, NSS (its CS), plus RST and DIO0. 3.3 V only. With #include <LoRa.h>: LoRa.setPins(ss, rst, dio0); LoRa.begin(433E6); LoRa.beginPacket(); LoRa.print(\"hi\"); LoRa.endPacket(); and on the other one: int n = LoRa.parsePacket(); if (n) while (LoRa.available()) Serial.print((char)LoRa.read()). Sending takes the real air time (SF7, 125 kHz: about 50 ms for 20 bytes; SF12: over a second). Two radios hear each other only with the same frequency, spreading factor, bandwidth and sync word.",
   "swatch": "#2e7d4f",
   "mass": 3,
   "shape": [
    {
     "box": [
      2.77,
      0.16,
      2.04
     ],
     "at": [
      0,
      0.08,
      0
     ],
     "color": "#2e7d4f"
    },
    {
