 "programs": {
  "board": {
   "lang": "arduino",
   "source": "// Continuous servos: turn the knob (its slider in the run panel). The middle stops both servos; to\n// either side they spin that way, faster the further you go. write() sets SPEED, not an angle.\n#include <Servo.h>\n\n#define KNOB A0\nServo small;    // FS90R\nServo big;      // MG996R 360\n\nvoid setup() {\n  Serial.begin(115200);\n  small.attach(2);\n  big.attach(3);\n}\n\nvoid loop() {\n  int speed = map(analogRead(KNOB), 0, 4095, 0, 180);   // 90 = stop\n  small.write(speed);\n  big.write(speed);\n  Serial.print(\"write(\");\n  Serial.print(speed);\n  if (speed == 90) Serial.println(\") = stop\");\n  else if (speed < 90) Serial.println(\") = one way\");\n  else Serial.println(\") = the other way\");\n  delay(200);\n}\n"
  }
 },
 "boards": []
}