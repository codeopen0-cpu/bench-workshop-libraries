 "programs": {
  "board": {
   "lang": "arduino",
   "source": "// Light chaser: eight LEDs on a 74HC595, from three pins. One light runs back and forth.\n#define DATA 2    // DS\n#define CLOCK 3   // SHCP\n#define LATCH 4   // STCP\n\nvoid show(byte pattern) {\n  digitalWrite(LATCH, LOW);\n  shiftOut(DATA, CLOCK, MSBFIRST, pattern);\n  digitalWrite(LATCH, HIGH);   // the outputs change now, all at once\n}\n\nvoid setup() {\n  pinMode(DATA, OUTPUT);\n  pinMode(CLOCK, OUTPUT);\n  pinMode(LATCH, OUTPUT);\n  Serial.begin(115200);\n}\n\nvoid loop() {\n  for (int i = 0; i < 8; i++) { show(1 << i); delay(80); }\n  for (int i = 6; i > 0; i--) { show(1 << i); delay(80); }\n}\n"
  }
 },
 "boards": []
