{
  "format": "bench-library",
  "formatVersion": 1,
  "id": "shift-register",
  "name": "Shift register (74HC595)",
  "version": "1.0.0",
  "author": "Bench Workshop",
  "owner": "codeopen0-cpu",
  "description": "The 74HC595 on a little board: eight more outputs from three pins. shiftOut() the bits on DS and SHCP, then pulse STCP to show them on Q0-Q7. Comes with a light-chaser example on eight LEDs.",
  "category": "Electronics",
  "needsApp": "0.3.0",
  "code": "device.js",
  "parts": [
    {
      "id": "hc595",
      "name": "Shift register (74HC595)",
      "description": "DS (data), SHCP (shift clock), STCP (latch): shiftOut(DS, SHCP, MSBFIRST, value); then STCP HIGH and LOW: Q7..Q0 show the byte (Q0 = its lowest bit with MSBFIRST). OE LOW = outputs on (pulled low on the board), MR HIGH = not clearing (pulled high). VCC 2-6 V, each Q gives up to 20 mA. Q7S goes on to the DS of a second one.",
      "swatch": "#2b2b2e",
      "mass": 2,
      "shape": [
        {
          "box": [
            3.0,
            0.16,
            2.4
          ],
          "at": [
            0,
            0.08,
            0
          ],
          "color": "#1d6b3a"
        },
        {
          "box": [
            2.0,
            0.3,
            0.75
          ],
          "at": [
            0,
            0.31,
            0
          ],
          "color": "#1a1a1c"
        },
        {
          "box": [
            0.12,
            0.02,
            0.12
          ],
          "at": [
            -0.9,
            0.465,
            -0.25
          ],
          "color": "#c9cdd4",
          "collide": false
        }
      ],
      "pinRows": [
        {
          "ids": [
            "Q0",
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "Q5",
            "Q6",
            "Q7"
          ],
          "at": [
            -0.889,
            0.0,
            1.0
          ],
          "kinds": {
            "Q0": "out",
            "Q1": "out",
            "Q2": "out",
            "Q3": "out",
            "Q4": "out",
            "Q5": "out",
            "Q6": "out",
            "Q7": "out"
          }
        },
        {
          "ids": [
            "VCC",
            "GND",
            "DS",
            "SHCP",
            "STCP",
            "OE",
            "MR",
            "Q7S"
          ],
          "at": [
            -0.889,
            0.0,
            -1.0
          ],
          "kinds": {
            "VCC": "vin",
            "GND": "gnd",
            "DS": "in",
            "SHCP": "in",
            "STCP": "in",
            "OE": "in",
            "MR": "in",
            "Q7S": "out"
          },
          "extra": {
            "VCC": {
              "label": "VCC (2-6 V)",
              "vmin": 2,
              "vmax": 6
            },
            "DS": {
              "label": "DS (data in)"
            },
            "SHCP": {
              "label": "SHCP (shift clock)"
            },
            "STCP": {
              "label": "STCP (latch)"
            },
            "OE": {
              "label": "OE (LOW = outputs on)",
              "pulled": "down"
            },
            "MR": {
              "label": "MR (LOW = clear)",
              "pulled": "up"
            },
            "Q7S": {
              "label": "Q7S (to the next DS)"
            }
          }
        }
      ],
      "device": "hc595"
    }
  ],
  "examples": [
    {
      "name": "Light chaser",
      "description": "Eight LEDs on one 74HC595, driven by three pins: a light runs back and forth. Press Run; add the Pin graph for DS, SHCP and STCP to see the bits go out.",
      "file": "examples/chaser.bench"
    }
  ]
}