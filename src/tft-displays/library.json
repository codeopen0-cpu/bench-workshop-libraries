  "parts": [
    {
      "id": "st7735",
      "name": "Colour TFT 1.8\" (ST7735, 128x160)",
      "description": "SPI: SCK and SDA (its MOSI) to the board's SPI pins, CS, A0 (DC: command or data) and RESET to any pins, VCC (3.3-5 V), GND, LED (backlight: to 3.3 V). #include <Adafruit_ST7735.h>; Adafruit_ST7735 tft = Adafruit_ST7735(CS, DC, RST); tft.initR(INITR_BLACKTAB); tft.fillScreen(ST77XX_BLACK);",
      "swatch": "#141416",
      "mass": 15,
      "shape": [
        {
          "box": [
            3.4,
            0.16,
            5.6
          ],
          "at": [
            0,
            0.08,
            -0.2
          ],
          "color": "#c83030"
        },
        {
          "box": [
            3.4,
            0.3,
            4.6
          ],
          "at": [
            0,
            0.31,
            0
          ],
          "color": "#141416"
        },
        {
          "screen": {
            "id": "tft",
            "size": [
              2.85,
              3.55
            ],
            "px": [
              128,
              160
            ],
            "mode": "rgb",
            "bg": "#000000"
          },
          "at": [
            0,
            0.462,
            0
          ]
        }
      ],
      "pinRows": [
        {
          "ids": [
            "LED",
            "SCK",
            "SDA",
            "A0",
            "RESET",
            "CS",
            "GND",
            "VCC"
          ],
          "at": [
            -0.889,
            0.0,
            -2.8
          ],
          "kinds": {
            "LED": "in",
            "SCK": "in",
            "SDA": "in",
            "A0": "in",
            "RESET": "in",
            "CS": "in",
            "GND": "gnd",
            "VCC": "vin"
          },
          "extra": {
            "VCC": {
              "label": "VCC (3.3-5 V)",
              "vmin": 2.8,
              "vmax": 5.5
            },
            "SDA": {
              "label": "SDA (its MOSI)"
            },
            "A0": {
              "label": "A0 (DC: data / command)"
            },
            "RESET": {
              "pulled": "up"
            },
            "LED": {
              "label": "LED (backlight)",
              "pulled": "up"
            }
          }
        }
      ],
      "spi": {
        "sck": "SCK",
        "mosi": "SDA",
        "cs": "CS"
      },
      "device": "st7735"
    },
